@using LiteInvest.Entity.ServerEntity
@using LiteInvestFront.Services

@inject IJSRuntime js;
@inject UiLogicService apiDataService;

@if (true) { }
<div class="instrument-header @((apiDataService.SelectedSecurityHash == Security.SpecialHash) ? "picked" : "")" @onclick="() => OnHeaderClick(Security.SpecialHash)">
    <div class="instrument-header__content">
        @Security.Isin
        <WorkWindowSettings securityApi="Security"></WorkWindowSettings>
    </div>
    <svg class="buttonclose" @onclick="() => OnClosingMain(Security)" xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10">
        <line x1="0" y1="0" x2="10" y2="10" stroke="black" stroke-width="2" />
        <line x1="0" y1="10" x2="10" y2="0" stroke="black" stroke-width="2" />
    </svg>
</div>

@code {
    [Parameter] public SecurityApi? Security { get; set; }
    [Parameter] public Action<SecurityApi> OnClosingMain { get; set; }
    [Parameter] public Action<string> OnHeaderClick { get; set; }

    protected async override Task OnInitializedAsync()
    {
        apiDataService.SelectedSecurityHashChanged += () => InvokeAsync(StateHasChanged);
    }
}
