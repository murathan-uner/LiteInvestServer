@using System.Collections.Concurrent
@using System.Collections.ObjectModel
@using System.Drawing
@using System.Globalization
@using LiteInvestFront.Components.Common
@using LiteInvestFront.Entity
@using LiteInvestFront.Services
@using LiteInvest.Entity.Helpers

@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using Telerik.Blazor.Components
@using Telerik.DataSource
@using Telerik.DataSource.Extensions
@using _Imports = LiteInvestFront.Components._Imports
@using GridRowClickEventArgs = Telerik.Blazor.Components.GridRowClickEventArgs
@using static LiteInvestFront.Components.Pages.WindowsRenderer

@inject UiLogicService UILogicSvcInstance
@inject ServerService _serverService
@inject JsInteropService JSInteropService
@inject IJSRuntime JSRuntime
@implements IDisposable

@rendermode InteractiveServer

@if (securityMain != null)
{
    <div id="@securityMain.SpecialHash" class="windows-root-panel" tabindex="0">
        <WorkWindowHeader securityMain="@securityMain">
        </WorkWindowHeader>

        <div class="windows-panel">
            <ClustersComponent TabId="@TabId" securityMain="@securityMain" ScaleIndex="@ScaleIndex" ScaleList="@ScaleList"></ClustersComponent>
            <Chart TabId="@TabId" securityMain="@securityMain"></Chart>
            <QuotesComponent TabId="@TabId" securityMain="@securityMain" ScaleIndex="@ScaleIndex" ScaleList="@ScaleList"></QuotesComponent>
        </div>

        <div class="error-line @ErrorLineClass">
            @ErrorMessage
        </div>

        <div class="algo-popup like-trades-volume-popup hidden">
            <div class="popup-content">
                <div class="popup-label">Enter the amount in lots</div>
                <input type="number" class="popup-input input-volume" min="1" />
                <div class="popup-label">Min=1 Decimal</div>
                <div class="popup-label">(Esc - Exit, Enter - Assign)</div>
            </div>
        </div>
    </div>
}

@code {

    [Parameter] public string? TabId { get; set; }
    [Parameter] public SecurityApi? securityMain { get; set; }
    [Parameter] public string lastsecHashOpened { get; set; } = string.Empty;
    [Parameter] public int WindowsOpened { get; set; } = 0;
    [Parameter] public List<int> ScaleList { get; set; }

    private int ScaleIndex { get; set; } = 0;

    private string ErrorLineClass = "error-none";
    private string ErrorMessage { get; set; } ="";

    protected override void OnInitialized()
    {
        Console.WriteLine($"{DateTime.Now} On Initialized secID{securityMain?.id} set WorkWindow");

        if (securityMain != null)
        {
            var profile = _serverService.GetUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash);
            if (profile != null)
            {
                ScaleIndex = profile.Scale;
            }
        }

        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (securityMain != null)
            {
                UILogicSvcInstance.ScaleChangeAction += OnScaleChanged;
                JSInteropService.OnToggleAutomicCentering += OnToggleAutomicCenteringCallback;
                _serverService.AttentionMessageForTraderEvent += AddNotification;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    bool firstrender = false;
    protected override void OnAfterRender(bool _firstRender)
    {
        if (_firstRender)
            firstrender = true;

        base.OnAfterRender(_firstRender);
    }

    private void OnScaleChanged(string windowId, int scaleIndex)
    {
        if (windowId == securityMain?.SpecialHash)
        {
            ScaleIndex = scaleIndex;
            ScaleIndex = Math.Clamp(ScaleIndex, 0, ScaleList.Count - 1);
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnToggleAutomicCenteringCallback(string windowId, bool on)
    {
        if (windowId != securityMain?.SpecialHash) return;

        // save user profile
        // (automatic centering flag change)
        var profile = _serverService.GetUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash);
        if (profile != null)
        {
            profile.AutomaticScrollFlag = on;
            _serverService.SaveUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash, profile);
        }

        string message = on ? "Automic scrolling on" : "Automic scrolling off";
        ShowNotification(message, AttentionMessageType.IntermediatePriority);
    }

    private void ShowNotification(string message, AttentionMessageType messageType)
    {
        ErrorMessage = message;
        switch (messageType)
        {
            case AttentionMessageType.CriticalError:
                ErrorLineClass = "error-red";
                break;
            case AttentionMessageType.Error:
                ErrorLineClass = "error-black";
                break;
            case AttentionMessageType.Info:
                ErrorLineClass = "error-blue";
                break;
            case AttentionMessageType.IntermediatePriority:
                ErrorLineClass = "error-blue";
                break;
            default:
                break;
        }
        InvokeAsync(StateHasChanged);
        timerNotification?.Stop();
        timerNotification = Helper.CreateTimerAndStart(() =>
        {
            ErrorLineClass = "error-none";
            InvokeAsync(StateHasChanged);
        }, 2000, false);
    }

    public void Dispose()
    {
        Console.WriteLine($"Disposing {securityMain?.id}");

        UILogicSvcInstance.ScaleChangeAction -= OnScaleChanged;
        JSInteropService.OnToggleAutomicCentering -= OnToggleAutomicCenteringCallback;
        _serverService.AttentionMessageForTraderEvent -= AddNotification;
    }

    // public void CloseWindows(SecurityApi securityApi)
    // {
    //     // DO NOT FLIP THIS ORDER
    //     _serverService.DeleteUsersSelectedInstrumentAsync(UILogicSvcInstance.userName, securityMain);
    //     OnClosingWindows?.Invoke(securityApi);
    // }

    private System.Timers.Timer? timerNotification;
    public void AddNotification(AttentionMessageType messageType, string userName, string secId, string message)
    {
        if (UILogicSvcInstance.userName == userName && secId == securityMain?.id)
        {
            ShowNotification(message, messageType);
        }
    }
}
