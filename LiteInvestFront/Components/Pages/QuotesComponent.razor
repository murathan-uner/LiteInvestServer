@using System.Collections.Concurrent
@using System.Collections.ObjectModel
@using System.Timers
@using LiteInvestFront.Components.Common
@using LiteInvestFront.Services
@using LiteInvest.Entity.Helpers
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll

@inject UiLogicService UILogicSvcInstance
@inject ServerService _serverService

@implements IDisposable
@inject JsInteropService JSInteropService
@inject IJSRuntime JSRuntime

<div class="quote-container algo-container table-container"></div>

@code {

    const bool LOG_QUOTES = false;

    const int OrderBookLevels = 3000;

    [Parameter] public string? TabId { get; set; }
    [Parameter] public SecurityApi? securityMain { get; set; }
    private int _scaleIndex = 0; // index  for ScaleList start on 0
    [Parameter]
    public int ScaleIndex
    {
        get => _scaleIndex;
        set
        {
            if (_scaleIndex != value)
            {
                _scaleIndex = value;

                if (!firstDataArrived || ScaleList.Count <= _scaleIndex)
                {
                    return;
                }

                UpdateTable(forceToMiddle: true, ignoreReceiptSignal: true);
            }
        }
    }
    [Parameter] public List<int> ScaleList { get; set; }

    private ConcurrentDictionary<int, List<MarketDepthLevel>> ScaledQuotes { get; set; } = new();
    private ConcurrentDictionary<int, int> CentreQuotes = new();
    private ConcurrentDictionary<int, (MarketDepthLevel BestBid, MarketDepthLevel BestAsk)> BestLevels = new();

    private string IdSubscription = string.Empty;

    /// <summary>
    /// Хранит информацию обо всех индексах
    /// </summary>
    private Dictionary<decimal, int> IndexesQuotes = new();
    private ConcurrentDictionary<int, Dictionary<decimal, int>> Indexes = new();

    private bool dataSentFlag = false;
    private bool disposed = false;

    /// <summary>
    /// Последний собранный масштаб
    /// </summary>
    private int PrevBuildScale { get; set; }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            JSInteropService.OnInitializedWindows += OnInitializedWindowsCallback;
            JSInteropService.OnAcceptedQuoteData += OnAcceptedQuoteDataCallback;
        }

        base.OnAfterRender(firstRender);
    }

    bool firstDataArrived = false; // same as gotfirstorderbook

    /// <summary>
    /// Main method to work with quotes
    /// </summary>
    /// <param name="insideQuotes"></param>
    private void OnNewScaledMarketDepth(InsideQuotes insideQuotes)
    {
        if (securityMain?.id != insideQuotes.SecurityId)
            return;

        // Console.WriteLine($"{securityMain.Isin} QUOTES UPDATE ");

        ScaledQuotes = insideQuotes.ScaledQuotes;
        CentreQuotes = insideQuotes.CentreQuotes;
        Indexes = insideQuotes.IndexPriceLevelQuotes;

        //Console.WriteLine($"BestBid={insideQuotes.BestLevels[myScale].BestBid.Price} ,BestAsk={insideQuotes.BestLevels[myScale].BestAsk.Price}  ");
        BestLevels = insideQuotes.BestLevels;
        //Console.WriteLine($"BestBid={BestBidAsk.BestBid.Price} ,BestAsk={BestBidAsk.BestAsk.Price}");

        if (!firstDataArrived)
            firstDataArrived = true;

        UpdateTable();
    }

    private void UpdateTable(bool forceToMiddle = false, bool ignoreReceiptSignal = false)
    {
        if (forceToMiddle || ignoreReceiptSignal)
            Console.WriteLine("+++ 0 " + "securityMain: " + (securityMain != null) + " dataSentFlag: " + dataSentFlag + " scaledQuotes: " + (ScaledQuotes != null));

        if (securityMain == null || ScaledQuotes == null) return;
        if (!ignoreReceiptSignal && dataSentFlag) return;

        if (forceToMiddle || ignoreReceiptSignal)
            Console.WriteLine("+++ 1");

        var scale = ScaleList[ScaleIndex];

        if (!ScaledQuotes.TryGetValue(scale, out var quotes)) return;
        if (!Indexes.TryGetValue(scale, out var indexDict)) return;
        if (!CentreQuotes.TryGetValue(scale, out var bestBidIndex)) return;
        if (!BestLevels.TryGetValue(scale, out var bestBidAsk)) return;

        if (forceToMiddle || ignoreReceiptSignal)
            Console.WriteLine("+++ 2");
        if (quotes.Count < PlazaOptions.SizeBlankMarketLevelsCountPriceStep * 2) return;

        if (forceToMiddle || ignoreReceiptSignal)
            Console.WriteLine("+++ 3");

        dataSentFlag = true;

        if (forceToMiddle || ignoreReceiptSignal)
            Console.WriteLine("+++ 4");

        InvokeAsync(async () =>
        {
            if (disposed) return;
            if (forceToMiddle)
            {
                Console.WriteLine("forced to middle scroll");
            }

            await JSRuntime.InvokeVoidAsync("updateQuoteTableData", securityMain.SpecialHash, 
            quotes, forceToMiddle, 
            bestBidIndex, (double)bestBidAsk.BestAsk.Price, (double)bestBidAsk.BestBid.Price,
            scale);

            // await JSRuntime.InvokeVoidAsync("forwardToSharedWorker", new
            // {
            //     action = "update",
            //     instrumentId = securityMain.id,
            //     windowId = securityMain.SpecialHash,
            //     data = new {
            //         quotes = quotes,
            //         forceToMiddle = forceToMiddle,
            //         bestBidIndex = bestBidIndex,
            //         bestAskPrice = (double)bestBidAsk.BestAsk.Price,
            //         scal = scale,
            //         pnlData = pnlData
            //     }
            // });
        });
    }


    /* Begin Callbacks */

    private void OnInitializedWindowsCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        InvokeAsync(async () =>
        {
            if (disposed) return;
            var res = await _serverService.SubscribeForScaledOrderBook(securityMain.id, OnNewScaledMarketDepth);

            if (res.Success)
            {
                IdSubscription = res.Id;
                Console.WriteLine($"Subscription SUCCESS Order BOOK {securityMain.Isin}");
            }
            else
            {
                Console.WriteLine($"Error Subscription Order BOOK {securityMain.Isin}");
            }
        });
    }

    private void OnAcceptedQuoteDataCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        dataSentFlag = false;
    }

    /* End Callbacks */

    public async void Dispose()
    {
        disposed = true;
        JSInteropService.OnInitializedWindows -= OnInitializedWindowsCallback;
        JSInteropService.OnAcceptedQuoteData -= OnAcceptedQuoteDataCallback;

        if (securityMain != null)
        {
            if (!string.IsNullOrEmpty(IdSubscription))
            {
                var res = await _serverService.RemoveSubscribeForScaledOrderBook(securityMain.id, IdSubscription);

                Console.WriteLine($"{securityMain.Isin} quotes BOOK Unsubscription RES {res.Success}");

            }
        }
    }

}
