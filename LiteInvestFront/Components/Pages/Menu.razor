    [JSInvokable]
    public void SaveDialogProfile(string dialogType, object profileData)
    {
        DialogType type = dialogType switch
        {
            "instrumentPicker" => DialogType.InstrumentPicker,
            "activeOrders" => DialogType.ActiveOrders,
            "activePositions" => DialogType.ActivePositions,
            _ => throw new ArgumentException("Unknown dialog type")
        };

        try {
            var profileJson = JsonSerializer.Serialize(profileData);
            DialogProfile? profile = type switch
            {
                DialogType.InstrumentPicker => JsonSerializer.Deserialize<InstrumentPickerProfile>(profileJson),
                DialogType.ActiveOrders => JsonSerializer.Deserialize<ActiveOrdersDialogProfile>(profileJson),
                DialogType.ActivePositions => JsonSerializer.Deserialize<ActivePositionsDialogProfile>(profileJson),
                _ => null
            };

            if (profile != null)
                _serverService.SaveDialogProfile(UILogicSvcInstance.userName, type, profile);
        }
        catch (Exception e)
        {
            Console.WriteLine($"Parsing dialog profile failure " + e.Message);
        }
    }

