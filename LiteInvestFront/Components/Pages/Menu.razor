    private async void OnSubmitLogout()
    {
        // SavedOrdersLoadTimer?.Stop();
        UILogicSvcInstance.userName = string.Empty;
        var token = await LocalStorage.GetAsync<string>("token");
        if (!string.IsNullOrEmpty(token.Value))
            _serverService.Logout(token.Value);
        await LocalStorage.DeleteAsync("token");
        await JSRuntime.InvokeVoidAsync("logout");
        Navigation.NavigateTo("/", true);
    }

    private void ProcessAfterLoggedIn(string refreshToken)
    {

        InvokeAsync(async () =>
        {
            var allSecurities = _serverService.GetAllSecurities();
            await SetInitialiDataToJS(refreshToken, allSecurities);

            LoadSavedInstruments(allSecurities);

        });

        // Must separate this poll
        InvokeAsync(async () =>
        {
            // Load active orders and set them to JS
            await PollForActiveOrdersOpenedPositionsAsync();
        });

        var resOrder = _serverService.SubscribeForPrivateOrders(UILogicSvcInstance.userName, OnMyNewOrders);
        if (resOrder.Result.Success)
        {
            Console.WriteLine($"Subscription SUCCESS Orders");
            SubscribeIDForPrivateOrder = resOrder.Result.Id;
        }
    }

    private async Task SetInitialiDataToJS(string refreshToken, List<SecurityApi> allSecurities)
    {
        #region Instruments
        var favoriteSecurities = _serverService.GetUserFavoriteInstruments(UILogicSvcInstance.userName);
        var recentSecurities = _serverService.GetUserRecentInstruments(UILogicSvcInstance.userName);

        // var securityList = new List<SecurityDataJS>();
        var securityList = allSecurities.Select(security => {

            long timestamp = Helper.GetSafeUnixTimestamp(security.DateUpdateFromMoex);
            return new SecurityDataJS
            {
                Id = security.id,
                Symbol = security.Isin,
                FullName = security.FullName,
                Type = security.Type,
                // DateUpdateFromMoex = security.DateUpdateFromMoex.ToShortDateString()
                UpdatedAt = timestamp
            };
        }).ToList();

        List<string> favoriteList;
        if (favoriteSecurities == null)
            favoriteList = [];
        else
            favoriteList = favoriteSecurities.Keys.ToList(); // list of favorite security id

        List<SecurityProfileRecentJS> recentList;
        if(recentSecurities != null)
        {
            recentList = recentSecurities.Values.Select(security => new SecurityProfileRecentJS
                {
                    Id = security.Item2.Id,
                    OrderIndex = security.Item1
                }).ToList();
        } else
        {
            recentList = [];
        }
        #endregion Instruments


        #region Tab Profile
        TabProfile? masterTabProfile = null;
        if (IsMasterTab())
        {
            masterTabProfile = _serverService.GetUserMasterTab(UILogicSvcInstance.userName);
        }
        #endregion Tab Profile


        #region Dialog Profile
        var instrumentPickerProfile = _serverService.GetDialogProfile(UILogicSvcInstance.userName, DialogType.InstrumentPicker);
        var activeOrdersDialogProfile = _serverService.GetDialogProfile(UILogicSvcInstance.userName, DialogType.ActiveOrders);
        var activePositionsDialogProfile = _serverService.GetDialogProfile(UILogicSvcInstance.userName, DialogType.ActivePositions);
        #endregion Dialog Profile

        await JSRuntime.InvokeVoidAsync("setInitialiData", refreshToken,

        // instruments
        new {
            Securities = securityList, 
            FavSecurities = favoriteList,
            RecentSecurities = recentList
        },

        // tab profile
        new
        {
            MasterTabProfile = masterTabProfile
        },

        // dialogs profile
        new
        {
            InstrumentPickerProfile = (InstrumentPickerProfile?)instrumentPickerProfile,
            ActiveOrdersDialogProfile = (ActiveOrdersDialogProfile?)activeOrdersDialogProfile,
            ActivePositionsDialogProfile = (ActivePositionsDialogProfile?)activePositionsDialogProfile
        }
        );
    }

    private void LoadSavedInstruments(List<SecurityApi> allSecurities)
    {
        if (string.IsNullOrWhiteSpace(UILogicSvcInstance.userName))
            return;

        var instruments = _serverService.GetUserInstrumentsByTab(UILogicSvcInstance.userName, TabId);
        if (instruments != null && instruments?.Count > 0)
        {
            var displayOrders = _serverService.GetUsersInstrumentOrders(UILogicSvcInstance.userName, TabId);
            if (displayOrders != null && displayOrders.Count > 0)
            {
                try
                {
                    var instrumentsOrdered = instruments
                        // .Where(kv => orders.ContainsKey(kv.Key))
                        // .OrderBy(kv => orders[kv.Key])
                        .OrderBy(kv => displayOrders.TryGetValue(kv.Key, out var val) ? val : int.MaxValue)
                        .ToDictionary(kv => kv.Key, kv => kv.Value);

                    List<SecurityApi> secs = new();
                    foreach (var instrument in instrumentsOrdered)
                    {
                        var sec = allSecurities.FirstOrDefault(s => s.id == instrument.Value.Id);
                        if (sec != null)
                        {
                            var newSec = (SecurityApi)sec.Clone();
                            newSec.SpecialHash = instrument.Key;
                            newSec.Profile = instrument.Value;
                            secs.Add(newSec);
                        }
                    }

                    // Notify - InstrumentsLoadAction
                    UILogicSvcInstance.NotifyAllInstrumentOpened(secs);

                }
                catch (Exception e)
                {

                }
            }
            else
            {
                List<SecurityApi> secs = new();
                foreach (var instrument in instruments)
                {
                    var sec = allSecurities.FirstOrDefault(s => s.id == instrument.Value.Id);
                    if (sec != null)
                    {
                        var newSec = (SecurityApi)sec.Clone();
                        newSec.SpecialHash = instrument.Key;
                        newSec.Profile = instrument.Value;
                        secs.Add(newSec);
                    }
                }

                // Notify - InstrumentsLoadAction
                UILogicSvcInstance.NotifyAllInstrumentOpened(secs);
            }
        }
    }

