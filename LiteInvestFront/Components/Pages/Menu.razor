    private CancellationTokenSource? _ctsActiveOrdersOpenedPositions;
    private CancellationTokenSource? _ctsNonActiveOrders;
    private readonly object _pollingActiveOrdersOpenedPositionsLock = new object();
    private readonly object _pollingNonActiveLock = new object();

    private async Task PollForActiveOrdersOpenedPositionsAsync()
    {
        // TODO - test code
        // var positions1 = _serverService.GetClosedPositionsForUser(UILogicSvcInstance.userName);
        // if (positions1.Count > 0)
        // {
        //     var openedPositionsJs = positions1.Select(pos =>
