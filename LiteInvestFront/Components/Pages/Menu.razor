    private void PromptChangeTapCaption()
    {
        if (IsMasterTab()) return;
        TempTabCaption = TabProfile?.Caption ?? "";
        TabCaptionLabelClass = "action-label d-none";
        TabCaptionInputClass = "action-input";
        StateHasChanged();
    }

    private void ConfirmChangeTabCaption()
    {
        if (IsMasterTab()) return;
        TabCaptionLabelClass = "action-label";
        TabCaptionInputClass = "action-input d-none";
        if (!string.IsNullOrWhiteSpace(TempTabCaption) && TabProfile != null && !string.Equals(TabProfile.Caption, TempTabCaption))
        {
            TabProfile.Caption = TempTabCaption.Length > 255 ? TempTabCaption.Substring(0, 255) : TempTabCaption;
            _serverService.SaveTab(UILogicSvcInstance.userName, TabProfile);

            JSRuntime.InvokeVoidAsync("tabCaptionUpdated", TempTabCaption);
        }
        StateHasChanged();
    }

    private async void OnMenuLoginClick()
    {
        if (!isLoggedIn())
        {
            loginFormVisible = true;
        }
        else
        {
            MouseEventArgs args = new MouseEventArgs();
            await OnSubmitLogin(args);
        }
    }

    protected void OnClickMenuItemHandler(MenuItem item)
    {
        var id = item.ID;
        switch (id)
        {
            case MENU_ITEM_ID.NULL_ID:
                break;
            case MENU_ITEM_ID.ACTIVE_ORDERS:
                if (isLoggedIn())
                {
                    JSRuntime.InvokeVoidAsync("openActiveOrdersDialog");
                }
                break;
            case MENU_ITEM_ID.ACTIVE_POSITIONS:
                if (isLoggedIn())
                {
                    JSRuntime.InvokeVoidAsync("openActivePositionsDialog");
                }
                break;
            case MENU_ITEM_ID.FINREZ:
                if (isLoggedIn())
                {
                    finrezVisible = true;
                    StateHasChanged();
                    // JSRuntime.InvokeVoidAsync("openFinrezDialog");
                }
                break;
            case MENU_ITEM_ID.PROFILE:
                break;
            case MENU_ITEM_ID.LOGOUT:
                OnSubmitLogout();
                break;
        }
        CloseMenuIfNeccessary(id);
    }

    private void CloseMenuIfNeccessary(MENU_ITEM_ID menuID)
    {
        if (menuID != MENU_ITEM_ID.NULL_ID)
        {
            JSRuntime.InvokeVoidAsync("closeMenu");
        }
    }

    protected override void OnInitialized()
    {
        if (IsMasterTab()) return;
        TabCaptionLabelClass = "action-label";
        TabCaptionInputClass = "action-input d-none";
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // register JS interop
            var dotNetReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("setDotNetMenu", dotNetReference);

            _isRealInstance = true;

            string? token;
            if (string.IsNullOrWhiteSpace(Token))
            {
                var tokenResult = await LocalStorage.GetAsync<string?>("token");
                token = tokenResult.Value;
                if (string.IsNullOrWhiteSpace(Token))
                    Console.WriteLine($"Saved token: " + token);
            }
            else
            {
                token = Token;
                Console.WriteLine($"Parent token: " + token);
            }
            if (!string.IsNullOrWhiteSpace(token))
            {
                var (loginInfo, user) = _serverService.Login(token);
                if (user != null && string.IsNullOrWhiteSpace(loginInfo.errorMessage))
                {
                    LoginInfo.Login = user.Login;

                    // Update menu text
                    UILogicSvcInstance.userName = LoginInfo.Login;
                    AccountMenuItems[0].Text = LoginInfo.Login;

                    ProcessAfterLoggedIn(loginInfo.refreshToken);

                    // Schedule auto logout if token expires
                    // var expiration = loginInfo.expirationTime;
                    // var remaining = expiration - DateTime.UtcNow;
                    // if (remaining.TotalMilliseconds > 0)
                    // {
                    //     _ = Task.Delay(remaining).ContinueWith(async _ =>
                    //     {
                    //         await LocalStorage.DeleteAsync("token");
                    //         Navigation.NavigateTo("/", true);
                    //     });
                    // }

                    // open saved tabs
                    if (IsMasterTab()) // master tab
                    {
                        Console.WriteLine("OnAfterRenderAsync(Master)");
                        var tabs = _serverService.GetUserTabs(UILogicSvcInstance.userName);
                        if (tabs != null && tabs.Count > 0)
                        {
                            Console.WriteLine($"Master Tab(Refresh) {tabs.Count} {tabs[0].Id} {tabs[0].Caption}");
                            // await JSRuntime.InvokeVoidAsync("openWorkspaces", tabs.ToArray());
                            await JSRuntime.InvokeVoidAsync("openWorkspaces", tabs);
                        }
                    }
                    else // child tab
                    {
                        Console.WriteLine("OnAfterRenderAsync(Child)");
                        if (TabProfile != null)
                        {
                            Console.WriteLine($"--- Save child tab: {TabProfile.Caption}, {TabProfile.Id}");
                            _serverService.SaveTab(UILogicSvcInstance.userName, TabProfile);
                        }
                    }
                }
                else
                {
                    // Token is invalid or expired
                    await LocalStorage.DeleteAsync("token");
                    AccountMenuItems[0].Text = string.Empty;
                }
            }
            else
            {
                // No token in storage
                AccountMenuItems[0].Text = string.Empty;
            }

            StateHasChanged();
        }
    }

