        //         var bestprice = pos.Side == Side.Buy ? bestPrice.BestBid : bestPrice.BestAsk;
        //         return new PositionDataJs
        //             {
        //                 SecId = pos.SecId,
        //                 Symbol = pos.SecName,
        //                 EnterPrice = (double)pos.AverageEntry,
        //                 ExitPrice = (double)bestprice,
        //                 PriceStep = (double)pos.PriceStep,
        //                 PriceStepCost = (double)pos.PriceStepCost,
        //                 CurPos = (int)pos.PosValue,
        //                 ClosedVolume = pos.CloseTrades == null ? 0 : (int)pos.CloseTrades.Volume,
        //                 Side = pos.Side == Side.Buy ? 'L' : 'S',
        //                 Timestamp = new DateTimeOffset(pos.OpenTime).ToUnixTimeMilliseconds(),
        //                 Open = true
        //             };
        //     });

        //     await JSRuntime.InvokeVoidAsync("setOpenedPositions", openedPositionsJs);
        // }

        // Thread-safe cancellation token handling
        lock (_pollingActiveOrdersOpenedPositionsLock)
        {
            _ctsActiveOrdersOpenedPositions?.Cancel();
            _ctsActiveOrdersOpenedPositions?.Dispose();
            _ctsActiveOrdersOpenedPositions = new CancellationTokenSource();
        }

        var token = _ctsActiveOrdersOpenedPositions.Token;
        const int delayMs = 10_000; // 10 seconds

        try
        {
            while (!token.IsCancellationRequested)
            {
                var response = _serverService.GetActiveOrdersForUser(UILogicSvcInstance.userName);

                if (response.Message != ServerService.SERVER_WARNING_LOADING_ORDERS && response.Data != null)
                {
                    var activeOrdersJs = response.Data.Select(order => {

                        long timestamp = Helper.GetSafeUnixTimestamp(order.TimeCreate);
                        return new OrderDataJs
                        {
                            Id = order.NumberUserOrderId,
                            ExchangeOrderId = order.ExchangeOrderId,
                            SecId = order.SecurityId,
                            Symbol = order.SecIsin,
                            Price = (double)order.PriceOrder,
                            Volume = (int)order.Volume,
                            VolumeExecuted = (int)order.VolumeExecuted,
                            Timestamp = timestamp,
                            Side = order.Side == Side.Buy ? 'L' : 'S',
                            State = (int)order.State
                        };
                    }).ToList();

                    await JSRuntime.InvokeVoidAsync("setActiveOrders", activeOrdersJs);

                    var positions = _serverService.GetOpenPositionsForUser(UILogicSvcInstance.userName);
                    if (positions.Count > 0)
                    {
                        var openedPositionsJs = positions.Select(pos =>
                        {
                            var bestPrice = _serverService.GetBestBidAskPrice(pos.SecId);
                            var bestprice = pos.Side == Side.Buy ? bestPrice.BestBid : bestPrice.BestAsk;

                            long timestamp = Helper.GetSafeUnixTimestamp(pos.OpenTime);
                            return new PositionDataJs
                                {
                                    SecId = pos.SecId,
                                    Symbol = pos.SecName,
                                    EnterPrice = (double)pos.AverageEntry,
                                    ExitPrice = (double)bestprice,
                                    PriceStep = (double)pos.PriceStep,
                                    PriceStepCost = (double)pos.PriceStepCost,
                                    CurPos = (int)pos.PosValue,
                                    ClosedVolume = pos.CloseTrades == null ? 0 : (int)pos.CloseTrades.Volume,
                                    Side = pos.Side == Side.Buy ? 'L' : 'S',
                                    Timestamp = timestamp,
                                    Open = true
                                };
                        }).ToList();

                        await JSRuntime.InvokeVoidAsync("setOpenedPositions", openedPositionsJs);
                    }
                    break; // Exit after successful fetch
                }

                await Task.Delay(delayMs, token);
            }
        }
        catch (TaskCanceledException)
        {
            Console.WriteLine("Polling for active orders canceled.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in active orders polling: {ex.Message}");
        }
        finally
        {
            lock (_pollingActiveOrdersOpenedPositionsLock)
            {
                if (!token.IsCancellationRequested)
                {
                    _ctsActiveOrdersOpenedPositions?.Cancel();
                }
                _ctsActiveOrdersOpenedPositions?.Dispose();
                _ctsActiveOrdersOpenedPositions = null;
            }
        }
    }

    private async Task PollForNonActiveOrdersAsync(int type)
    {
        // Thread-safe cancellation token handling
        lock (_pollingNonActiveLock)
        {
            // Cancel previous polling (if any)
            _ctsNonActiveOrders?.Cancel();
            _ctsNonActiveOrders?.Dispose();
            _ctsNonActiveOrders = new CancellationTokenSource();
        }

        var token = _ctsNonActiveOrders.Token;
        const int delayMs = 10_000; // 10 seconds

        try
        {
            while (!token.IsCancellationRequested)
            {
                ServerResponce<List<Order>?>? response = type == 0
                    ? _serverService.GetCanceledOrdersForUser(UILogicSvcInstance.userName)
                    : _serverService.GetExecutedOrdersForUser(UILogicSvcInstance.userName);

                if (response?.Data != null && response.Message != ServerService.SERVER_WARNING_LOADING_ORDERS)
                {
                    var ordersJs = response.Data.Select(order =>
                    {
                        long timestamp = type == 0 ? Helper.GetSafeUnixTimestamp(order.TimeCancel) : Helper.GetSafeUnixTimestamp(order.TimeDone);
                        return new OrderDataJs
                        {
                            Id = order.NumberUserOrderId,
                            ExchangeOrderId = order.ExchangeOrderId,
                            SecId = order.SecurityId,
                            Symbol = order.SecIsin,
                            Price = (double)order.PriceOrder,
                            Volume = (int)order.Volume,
                            VolumeExecuted = (int)order.VolumeExecuted,
                            Timestamp = timestamp,
                            Side = order.Side == Side.Buy ? 'L' : 'S',
                            State = (int)order.State
                        };
                    }).ToList();

                    await (type == 0
                        ? JSRuntime.InvokeVoidAsync("setCanceledOrders", ordersJs)
                        : JSRuntime.InvokeVoidAsync("setExecutedOrders", ordersJs));

                    break; // Exit after successful fetch
                }

                await Task.Delay(delayMs, token);
            }
        }
        catch (TaskCanceledException)
        {
            Console.WriteLine("Polling for non-active orders canceled.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in non-active orders polling: {ex.Message}");
        }
        finally
        {
            lock (_pollingNonActiveLock)
            {
                if (!token.IsCancellationRequested)
                {
                    _ctsNonActiveOrders?.Cancel();
                }
                _ctsNonActiveOrders?.Dispose();
                _ctsNonActiveOrders = null;
            }
        }
    }

    private CancellationTokenSource? _ctsClosedPositions;
    private readonly object _pollingClosedLock = new object();

    private async Task PollForClosedPositionsAsync()
    {
        // Thread-safe cancellation token handling
        lock (_pollingClosedLock)
        {
            _ctsClosedPositions?.Cancel();
            _ctsClosedPositions?.Dispose();
            _ctsClosedPositions = new CancellationTokenSource();
        }

        var token = _ctsClosedPositions.Token;

        try
        {
            var positions = _serverService.GetClosedPositionsForUser(UILogicSvcInstance.userName);

            if (positions.Count > 0)
            {
                var closedPositionsJs = positions.Select(pos =>
                {
                    long timestamp = Helper.GetSafeUnixTimestamp(pos.OpenTime);
                    return new PositionDataJs
                    {
                        SecId = pos.SecId,
                        Symbol = pos.SecName,
                        EnterPrice = (double)pos.AverageEntry,
                        ExitPrice = (double)pos.AverageExit,
                        PriceStep = (double)pos.PriceStep,
                        PriceStepCost = (double)pos.PriceStepCost,
                        CurPos = (int)pos.PosValue,
                        ClosedVolume = pos.CloseTrades == null ? 0 : (int)pos.CloseTrades.Volume,
                        Side = pos.Side == Side.Buy ? 'L' : 'S',
                        Timestamp = timestamp,
                        Open = false
                    };
                }).ToList();

                await JSRuntime.InvokeVoidAsync("setClosedPositions", closedPositionsJs);
            }

        }
        catch (TaskCanceledException)
        {
            Console.WriteLine("Polling for closed positions canceled.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in closed positions polling: {ex.Message}");
        }
        finally
        {
            lock (_pollingClosedLock)
            {
                if (!token.IsCancellationRequested)
                {
                    _ctsClosedPositions?.Cancel();
                }
                _ctsClosedPositions?.Dispose();
                _ctsClosedPositions = null;
            }
        }
    }

    private void OnMyNewOrders(List<Order> myorders)
    {
        if (myorders.Count == 0) return;

        InvokeAsync(async () =>
        {
            var ordersJs = myorders.Select(order =>
            {
                var restvolume = order.Volume - order.VolumeExecuted;
                Console.WriteLine($"New Order {order.SecurityId} side = {order.Side} price {order.PriceOrder} state {order.State} rv = {restvolume}");

                long timestamp;
                try
                {
                    timestamp = order.State switch
                    {
                        Order.OrderStateType.Active or Order.OrderStateType.Partial => Helper.GetSafeUnixTimestamp(order.TimeCreate),
                        Order.OrderStateType.Cancel or Order.OrderStateType.Fail => Helper.GetSafeUnixTimestamp(order.TimeCancel),
                        Order.OrderStateType.Done => Helper.GetSafeUnixTimestamp(order.TimeDone),
                        _ => Helper.GetSafeUnixTimestamp(order.TimeCreate)
                    };
                }
                catch (Exception e)
                {
                    timestamp = 0;
                }

                return new OrderDataJs
                    {
                        Id = order.NumberUserOrderId,
                        ExchangeOrderId = order.ExchangeOrderId,
                        SecId = order.SecurityId,
                        Symbol = order.SecIsin,
                        Price = (double)order.PriceOrder,
                        Volume = (int)order.Volume,
                        VolumeExecuted = (int)order.VolumeExecuted,
                        Timestamp = timestamp,
                        Side = order.Side == Side.Buy ? 'L' : 'S',
                        State = (int)order.State
                    };
            }).ToList();

            Console.WriteLine($"OnMyNewOrders {ordersJs.Count} {ordersJs[0].Price}");
            await JSRuntime.InvokeVoidAsync("setNewOrders", ordersJs);

            var positions = _serverService.GetOpenPositionsForUser(UILogicSvcInstance.userName);
            var positionsJs = positions.Select(pos =>
            {
                long timestamp = Helper.GetSafeUnixTimestamp(pos.OpenTime);
                return new PositionDataJs
                {
                    SecId = pos.SecId,
                    Symbol = pos.SecName,
                    EnterPrice = (double)pos.AverageEntry,
                    ExitPrice = (double)pos.AverageExit,
                    PriceStep = (double)pos.PriceStep,
                    PriceStepCost = (double)pos.PriceStepCost,
                    CurPos = (int)pos.PosValue,
                    ClosedVolume = pos.CloseTrades == null ? 0 : (int)pos.CloseTrades.Volume,
                    Side = pos.Side == Side.Buy ? 'L' : 'S',
                    Timestamp = timestamp,
                    Open = true
                };
            }).ToList();

            Console.WriteLine($"OnMyNewPositions {positionsJs.Count}");
            await JSRuntime.InvokeVoidAsync("setOpenedPositions", positionsJs);
            //
            // TODO - for better performance(since closed positions will grow huge), SubscribeForPrivatePosition should be implemented in ProcessNewMyTrade
            // 
        });
    }

    [JSInvokable]
    public void SaveTabProfile(TabProfile tabProfile)
    {
        if (IsMasterTab()) // master tab
        {
            Console.WriteLine("SaveTabProfile(master)");
            _serverService.SaveMasterTab(UILogicSvcInstance.userName, tabProfile);
        }
        else
        {
            Console.WriteLine("SaveTabProfile(child) " + TabId);
            _serverService.SaveTab(UILogicSvcInstance.userName, tabProfile);
        }
    }

    [JSInvokable]
    public void RemoveTabProfile()
    {
        // remove child tab profile
        if (!IsMasterTab() && TabId != null)
        {
            Console.WriteLine("RemoveTabProfile");
            _serverService.DeleteTab(UILogicSvcInstance.userName, TabId);
            _serverService.DeleteUserInstrumentOrdersAsync(UILogicSvcInstance.userName, TabId);
            _serverService.DeleteUserInstrumentsAsync(UILogicSvcInstance.userName, TabId);
        }
    }

    [JSInvokable]
    public void RemoveTabProfiles(List<string> tabIds)
    {
        // remove child tab profiles from master tab
        if (IsMasterTab() && tabIds != null)
        {
            Console.WriteLine("RemoveTabProfiles");
            foreach (var id in tabIds)
            {
                _serverService.DeleteTab(UILogicSvcInstance.userName, id);
                _serverService.DeleteUserInstrumentOrdersAsync(UILogicSvcInstance.userName, id);
                _serverService.DeleteUserInstrumentsAsync(UILogicSvcInstance.userName, id);
            }
        }
    }

