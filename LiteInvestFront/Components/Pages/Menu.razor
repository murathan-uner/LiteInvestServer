@if (IsMasterTab())
{
    <TelerikWindow @bind-Visible=finrezVisible
    ContainmentSelector="body"
    Resizable="false"
    Draggable="true"
    Width="60vw"
    MinWidth="40vw"
    Height="30vh"
    MinHeight="30vh"
    MaxHeight="80vh">
        <WindowContent>
            <FinrezComponent />
        </WindowContent>
        <WindowTitle>
            Финрез
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" />
        </WindowActions>
    </TelerikWindow>
    <TelerikWindow @bind-Visible=loginFormVisible
    Resizable="true"
    MinWidth="300"
    MinHeight="200"
    Centered="true"
    Modal="true"
    MaxWidth="800"
    CloseOnOverlayClick="true"
    MaxHeight="500">
        <WindowContent>

            <TelerikForm Model="@LoginInfo">
                <FormItems>
                    <FormItem Field="@nameof(UserLoginData.Login)">

                    </FormItem>
                    <FormItem Field="@nameof(UserLoginData.Password)">

                    </FormItem>
                </FormItems>

                <FormButtons>
                    <TelerikButton OnClick="OnSubmitLogin" Class="login_button">
                        Войти
                        <TelerikLoader Class="loader-indicator" ThemeColor="light" Visible="@loadingLogIn"></TelerikLoader>
                    </TelerikButton>

                </FormButtons>
            </TelerikForm>
            @if (!string.IsNullOrWhiteSpace(@textForLogin))
            {
                <p style="color: @colorforlogin;">@textForLogin</p>
            }
        </WindowContent>
    </TelerikWindow>

    <TelerikAppBar>
        <AppBarSection>
            <a class="logo" target="_blank" href="https://www.lite-invest.com/">LiteInvest</a>
        </AppBarSection>

        <AppBarSection Visible="@isLoggedIn()">
            <a class="action-item action-item-fill action-item-icon" id="btn-select-instrument" href="#" title="@Localizer["select_instrument"]">
                <i class="bi bi-folder2-open"></i>
            </a>
        </AppBarSection>

        <AppBarSection Visible="@isLoggedIn()">
            <a class="action-item action-item-fill action-item-icon" id="btn-add-workspace" href="#" title="@Localizer["add_workspace"]">
                <i class="bi bi-window-plus"></i>
            </a>
        </AppBarSection>

        <AppBarSection Visible="@isLoggedIn()">
            <TelerikMenu Data="@SettingsMenuItems"
            ShowOn="@MenuShowEvent.Click"
            HideOn="@MenuHideEvent.Click"
            OnClick="@((MenuItem item) => OnClickMenuItemHandler(item))" />
        </AppBarSection>

        <AppBarSpacer />

        <AppBarSection>
            <a class="action-item action-item-fill action-item-text" target="_blank" href="https://docs-cassandra.lite-invest.com">
                <i class="bi bi-globe" style="margin-right: 5px;"></i> @Localizer["documentation"]
            </a>
        </AppBarSection>

        <AppBarSection>
            @if (isLoggedIn())
            {
                <TelerikMenu Data="@AccountMenuItems"
                ShowOn="@MenuShowEvent.Click"
                HideOn="@MenuHideEvent.Click"
                OnClick="@((MenuItem item) => OnClickMenuItemHandler(item))" />
            }
            else
            {
                <a class="action-item action-item-text" href="#" @onclick="OnMenuLoginClick">Log In</a>
            }
        </AppBarSection>
    </TelerikAppBar>

    @* Move JavaScript code to a separate JS file in production *@
    <script suppress-error="BL9992">
        function closeMenu() {
        var pointerEvent = new PointerEvent("pointerdown");
        document.documentElement.dispatchEvent(pointerEvent);
        }
    </script>
}
else
{
    <TelerikAppBar>
        <AppBarSection Visible="@isLoggedIn()">
            <a class="action-item action-item-fill action-item-icon" id="btn-select-instrument" href="#" title="@Localizer["select_instrument"]">
                <i class="bi bi-folder2-open"></i>
            </a>
        </AppBarSection>

        <AppBarSpacer />
        <AppBarSection>
            <span class="@(TabCaptionLabelClass ?? "")" @ondblclick="@PromptChangeTapCaption">@TabProfile?.Caption</span>
            <TelerikTextBox Class="@(TabCaptionInputClass ?? "")" @bind-Value="@TempTabCaption" OnChange="@ConfirmChangeTabCaption" MaxLength="255" />
        </AppBarSection>
        <AppBarSpacer />

        <AppBarSection Visible="@isLoggedIn()">
            <a class="action-item action-item-fill action-item-icon" id="btn-close-workspace" href="#" title="@Localizer["close_workspace"]">
                <i class="bi bi-x-lg"></i>
            </a>
        </AppBarSection>
    </TelerikAppBar>
}

