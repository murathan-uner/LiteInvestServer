    /*
     * Running on worker's thread
     */
    private Random _random = new(); // temp variable MUST BE REMOVED
    public void ProcessTicks(/* string sec, */ List<Trade> ticks)
    {
        // if (sec != secutityMain.id)
        //     return;

        foreach (var tick in ticks)
        {
            Counter += 1;
            tick.IndexForChart = Counter;
            tick.BubbleSize = tick.Volume * (decimal)VolumeRatio;

            var volume = _random.Next(1, 100);
            var tickViewModel = new TradeViewModel()
            {
                IndexForChart = Counter,
                Price = _random.Next(20, 70),
                Volume = volume,
                BubbleSize = (decimal)(volume * VolumeRatio),
                Side = tick.Side
            };

            TickQueue.Enqueue(tickViewModel);
        }
    }

    /*
     * Bubble Chart Rendering function
     * Running on UI thread
     */
    private void ProcessTicksFromQueue(object? sender, ElapsedEventArgs e)
    {
        if (TickQueue.IsEmpty) return;

        List<TradeViewModel> newTicks = new();
        while (TickQueue.TryDequeue(out TradeViewModel tick))
        {
            newTicks.Add(tick);
        }

        if (newTicks.Count > 0)
        {
            InvokeAsync(() =>
            {
                Ticks.AddRange(newTicks);
                if (Ticks.Count > MaxAmount)
                {
                    Ticks.RemoveRange(1, Ticks.Count - MaxAmount);
                }

                if (Ticks.Count > 1)
                    Ticks[0].Price = Ticks[1].Price;

                StateHasChanged();
            });
        }
    }

    public async void PushInvokeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        //Console.WriteLine($"CHART Should Render {secutityMain.Isin}  {DateTime.Now}");
        return base.ShouldRender();
    }

