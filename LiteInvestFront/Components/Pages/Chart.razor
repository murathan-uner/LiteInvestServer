@using LiteInvestFront.Components.Common
@using LiteInvestFront.Entity
@using LiteInvestFront.Services
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using System.Collections.Concurrent
@using System.Timers
@inject IJSRuntime JSRuntime

@inject UiLogicService _uilogicservice
@inject ServerService _serverService

@implements IDisposable
@inject JsInteropService JSInteropService
@inject IJSRuntime JSRuntime

<div class="chart-container algo-container"></div>

@code {

    [Parameter] public string? TabId { get; set; }
    [Parameter] public SecurityApi? securityMain { get; set; }

    private string IdSubscription = string.Empty;

    private bool dataSentFlag = false;
    private bool disposed = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (securityMain == null)
                return;

            JSInteropService.OnInitializedWindows += OnInitializedWindowsCallback;
            JSInteropService.OnAcceptedChartData += OnAcceptedChartDataCallback;
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    /*
     * Running on worker's thread
     */
    public void ProcessTicks(List<Trade> ticks)
    {
        if (dataSentFlag) return;
        if (securityMain == null || ticks.Count == 0) return;

        var ticksDataJs = ticks.Select(tick => new TickDataJs
        {
            Price = (double)tick.Price,
            Volume = (int)tick.Volume,
            Side = tick.Side == Side.Buy ? 'L' : 'S'
        });

        dataSentFlag = true;

        InvokeAsync(async () =>
        {
            await JSRuntime.InvokeVoidAsync("addChartTicks", securityMain.SpecialHash, ticksDataJs);
        });
    }

    public async void Dispose()
    {
        disposed = true;
        JSInteropService.OnInitializedWindows -= OnInitializedWindowsCallback;
        JSInteropService.OnAcceptedChartData -= OnAcceptedChartDataCallback;

        if (securityMain != null)
        {
            await _serverService.RemoveSubscribeForTicks(securityMain.id, IdSubscription);
        }
    }

    /* Begin Callbacks */

    private void OnInitializedWindowsCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        var res = _serverService.SubscribeForTicks(securityMain.id, (t) => { ProcessTicks(t); });

        if (res.Success)
            IdSubscription = res.Id;
    }

    private void OnAcceptedChartDataCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        dataSentFlag = false;
    }

    /* End Callbacks */

    public class TickDataJs
    {
        public double Price { get; set; }
        public int Volume { get; set; }
        public char Side { get; set; }
    }
}
