    private double ViewportHeight = 0;
    private double VolumeRatio = 1;

    protected override async Task OnInitializedAsync()
    {
        // standard ticks
        TicksStandard.Add(new TradeViewModel() { IndexForChart = 0, Volume = (decimal)Constants.DEFAULT_CHART_MAX_VOLUME, Color = "" });
        //

