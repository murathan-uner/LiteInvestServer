    public async void Dispose()
    {
        _uilogicservice.NewMaxMin -= ProcessNewMaxMin;
        // ApidataService.NewTicks -= ProcessTicks;

        await _serverService.RemoveSubscribeForTicks(secutityMain.id, IdSubscription);
    }

}
