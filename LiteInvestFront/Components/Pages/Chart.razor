@using LiteInvestFront.Components.Common
@using LiteInvestFront.Entity
@using LiteInvestFront.Services
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using System.Collections.Concurrent
@using System.Timers
@inject IJSRuntime JSRuntime

@inject UiLogicService _uilogicservice
@inject ServerService _serverService

@implements IDisposable

<TelerikChart @ref="MainChart" Class="chart" Transitions="false" RenderAs="@RenderingMode.Canvas" Width="100%" Height="@Constants.VIEWPORT_HEIGHT_SIZE">

    <ChartLegend Visible="false"></ChartLegend>
    <ChartPannable Enabled="false"></ChartPannable>

    <ChartSeriesItems>

        <ChartSeries Type="ChartSeriesType.Bubble"
        Data="@TicksStandard"
        YField="@nameof(Trade.Price)"
        XField="@nameof(Trade.IndexForChart)"
        SizeField="@nameof(Trade.BubbleSize)"
        ColorField="@nameof(Trade.Color)">
        </ChartSeries>

        <ChartSeries Type="ChartSeriesType.ScatterLine"
        Data="@Ticks"
        YField="@nameof(Trade.Price)"
        XField="@nameof(Trade.IndexForChart)"
        Color="#808080"
        ZIndex="0">
            <ChartSeriesMarkers Visible="false"></ChartSeriesMarkers>
        </ChartSeries>

        <ChartSeries Type="ChartSeriesType.Bubble"
        Data="@Ticks"
        YField="@nameof(Trade.Price)"
        XField="@nameof(Trade.IndexForChart)"
        SizeField="@nameof(Trade.BubbleSize)"
        ColorField="@nameof(Trade.Color)"
        Opacity ="0.6"
        ZIndex="1">

            <ChartSeriesLabels Visible="true"
            Template="chartSeriesLabelTemplate"
            AriaTemplate="chartSeriesAriaTemplate" />

        </ChartSeries>

    </ChartSeriesItems>

    <ChartXAxes>
        <ChartXAxis Max="@Counter" Min="@(Counter-MaxAmount)" Visible="false">
        </ChartXAxis>
    </ChartXAxes>

    <ChartYAxes>
        <ChartYAxis Min="@ChartYMin" Max="@ChartYMax" Visible="false">
        </ChartYAxis>
    </ChartYAxes> 

</TelerikChart>


<script suppress-error="BL9992">
    function chartSeriesLabelTemplate(context) {
        return context.dataItem.Volume;
    }

</script>

@code {

    [Parameter]
    public SecurityApi secutityMain { get; set; }

    private ConcurrentQueue<Trade> TickQueue = new();
    private List<Trade> Ticks { get; set; } = new();
    private List<Trade> TicksStandard { get; set; } = new();

    //public int MaxAmount { get; set; } = 30; //надо разделить на шаг и получится реальное количество отображаемых элементов
    private int MaxAmount = Constants.DEFAULT_CHART_AMOUNT; // Dynamically updated

    static int maxStaticValue { get; set; } = 30;
    public int maxScaleForChart { get; set; } = 200;


    private decimal ChartYMin { get; set; } = Constants.DEFAULT_CHART_Y_MIN;
    private decimal ChartYMax { get; set; } = Constants.DEFAULT_CHART_Y_MAX;

    public TelerikChart MainChart { get; set; }

    private int Counter = 1;
    private int LastValue = 0;
    private string IdSubscription = string.Empty;

    private decimal basicvolume = 0;
    private int chartcount = 0;
    private DateTime lasttickupdate;

    private Timer RefreshTimer;

    private decimal ViewportWidth = 0;
    private decimal ViewportHeight = 0;
    private decimal VolumeRatio = 1;

    protected override async Task OnInitializedAsync()
    {
        // standard ticks
        TicksStandard.Add(new Trade() { IndexForChart = 0, Volume = Constants.DEFAULT_CHART_MAX_VOLUME });
        //

        //TODO: нам помоему сервер не отдает это значение
        basicvolume = secutityMain.Lot * maxScaleForChart * VolumeRatio;
        Ticks.Add(new Trade() { IndexForChart = -3 * maxStaticValue, Volume = basicvolume, });

        //Console.WriteLine($"{secutityMain.Isin} max value for chart {secutityMain.Lot * 300}");

        ChangeScaleOfChart();

        // Timer for refreshing the chart display
        RefreshTimer = new Timer(100);
        RefreshTimer.Elapsed += ProcessTicksFromQueue;
        RefreshTimer.Start();

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            var res = _serverService.SubscribeForTicks(secutityMain.id, (t) => { ProcessTicks(t); }).Result;

            if (res.Success)
                IdSubscription = res.Id;

            // ApidataService.NewTicks += ProcessTicks;
            _uilogicservice.NewMaxMin += ProcessNewMaxMin;

            await JSRuntime.InvokeVoidAsync("window.registerViewportChangeCallbackForChart", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void OnResize(int width, int height)
    {
        if (ViewportWidth == width && ViewportHeight == height) return;
        ViewportWidth = width;
        ViewportHeight = height;

        // recalculate
        var ViewportHeightRatio = Constants.DEFAULT_WINDOWS_HEIGHT / ViewportHeight;
        // VolumeRatio = Constants.DEFAULT_CHART_Y_RANGE / (ChartYMax - ChartYMin);
        VolumeRatio = ViewportHeightRatio;

        // Console.WriteLine($"volume ratio: {VolumeRatio} {ViewportHeightRatio}");

        ChartYMin = Constants.DEFAULT_CHART_Y_MIN_RATIO * ViewportHeight;
        ChartYMax = Constants.DEFAULT_CHART_Y_MAX_RATIO * ViewportHeight;
        var maxVolume = Constants.DEFAULT_CHART_MAX_VOLUME_RATIO * ViewportHeight;
        TicksStandard[0].Volume = maxVolume;

        InvokeAsync(StateHasChanged);
    }

    private void ProcessNewMaxMin(SecurityApi sec, double max, double min)
    {
        if (sec.SpecialHash != secutityMain.SpecialHash)
            return;

        SetMaxMin(max, min);
    }

    public void ChangeScaleOfChart()
    {
        //TODO: решил сделать реализацию через инжект.
        // Возможно это опасно

        var newvalue = _uilogicservice.openedInstruments;

        if (newvalue == 0) newvalue = 1;

        if(LastValue==newvalue)
            return;

        LastValue = newvalue;

        var res = maxStaticValue / (newvalue );


        if (Ticks!=null && Ticks.Count > 0)
        {
            Ticks[0].Volume = basicvolume / newvalue;
            Ticks[0].BubbleSize = Ticks[0].Volume * VolumeRatio;
        }

        MaxAmount = (int)res;

        if(Ticks!=null && Ticks.Count>0)
            Console.WriteLine($"new max amount {MaxAmount} {secutityMain.Isin}  №{newvalue} of windows (CHART MESSAGE) ticksvol = {Ticks[0].Volume}");
        InvokeAsync(StateHasChanged);
    }

    /*
     * Running on worker's thread
     */
    public void ProcessTicks(/* string sec, */ List<Trade> ticks)
    {
        // if (sec != secutityMain.id)
        //     return;

        if(ticks == null)
            return;

        foreach (var tick in ticks)
        {
            Counter += 1;
            tick.IndexForChart = Counter;
            tick.BubbleSize = tick.Volume * VolumeRatio;
            TickQueue.Enqueue(tick);
        }
    }

    /*
     * Bubble Chart Rendering function
     * Running on UI thread
     */
    private void ProcessTicksFromQueue(object? sender, ElapsedEventArgs e)
    {
        if (TickQueue.IsEmpty) return;

        List<Trade> newTicks = new();
        while (TickQueue.TryDequeue(out Trade tick))
        {
            newTicks.Add(tick);
        }

        if (newTicks.Count > 0)
        {
            InvokeAsync(() =>
            {
                Ticks.AddRange(newTicks);
                if (Ticks.Count > MaxAmount)
                {
                    Ticks.RemoveRange(1, Ticks.Count - MaxAmount);
                }

                if (Ticks.Count > 1)
                    Ticks[0].Price = Ticks[1].Price;

                StateHasChanged();
            });
        }
    }

    public async void PushInvokeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        //Console.WriteLine($"CHART Should Render {secutityMain.Isin}  {DateTime.Now}");
        return base.ShouldRender();
    }

    public void SetMaxMin(double max, double min)
    {
        try
        {
            ChartYMin = (decimal) min;
            ChartYMax = (decimal) max;

            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    public void Dispose()
    {
        _uilogicservice.NewMaxMin -= ProcessNewMaxMin;
        _serverService.RemoveSubscribeForTicks(secutityMain.id, IdSubscription);

        // ApidataService.NewTicks -= ProcessTicks;
    }

}
