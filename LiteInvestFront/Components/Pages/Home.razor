@* @page "/counter" *@
@page "/"

@using System.Collections.ObjectModel
@using LiteInvestFront.Services
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using System.Net
@using System.Text
@using Telerik.Blazor.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using System.Text.Json;

@inject UiLogicService UILogicSvcInstance
@inject ServerService _serverService
@inject NavigationManager Navigation
@inject JsInteropService jsInteropService
@inject IJSRuntime js
@inject IStringLocalizer<SharedResources> Localizer

@implements IDisposable

<link rel="stylesheet" href="css/windows-renderer.css" />

<Menu Token="@Token" TabId="@TabId" TabProfile="@TabProfile"></Menu>
<WindowsRenderer TabId="@TabId" />

@code {

    private string? Token;
    private string? TabId;
    private int TabIndex = 0;
    private TabProfile? TabProfile;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = QueryHelpers.ParseQuery(uri.Query);
        string? tabCaption = string.Empty;

        // if (queryParams.TryGetValue("index", out var tabIndex))
        // {
        //     if (int.TryParse(tabIndex, out int _tabIndex))
        //         TabIndex = _tabIndex;
        //     else
        //         TabIndex = 0;
        // }
        // if (queryParams.TryGetValue("tabId", out var tabId))
        // {
        //     TabId = tabId;
        // }
        // if (queryParams.TryGetValue("caption", out var _tabCaption))
        // {
        //     tabCaption = _tabCaption;
        // }

        if (queryParams.TryGetValue("q", out var encoded))
        {
            try
            {
                // 1. URL-decode (since JavaScript used `encodeURIComponent`)
                var fullyDecoded = Uri.UnescapeDataString(encoded); // More aggressive URL decoding

                // 2. Base64 decode → Bytes
                var jsonBytes = Convert.FromBase64String(fullyDecoded);

                // 3. Convert Bytes → UTF-8 String (handles Unicode properly)
                var json = Encoding.UTF8.GetString(jsonBytes);

                // 4. Deserialize JSON
                var parameters = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);

                if (parameters.TryGetValue("caption", out var captionElement))
                    tabCaption = captionElement.GetString();

                if (parameters.TryGetValue("token", out var tokenElement))
                    Token = tokenElement.GetString();

                if (parameters.TryGetValue("tabId", out var idElement))
                    TabId = idElement.GetString();

                if (parameters.TryGetValue("index", out var indexElement))
                    TabIndex = indexElement.GetInt32();

                if (!string.IsNullOrEmpty(TabId)) // child tab
                {
                    // save tab profile
                    if (parameters.TryGetValue("left", out var leftElement) &&
                        parameters.TryGetValue("top", out var topElement) &&
                        parameters.TryGetValue("width", out var widthElement) &&
                        parameters.TryGetValue("height", out var heightElement))
                    {
                        var left = leftElement.GetInt32();
                        var top = topElement.GetInt32();
                        var width = widthElement.GetInt32();
                        var height = heightElement.GetInt32();

                        TabProfile = new TabProfile
                        {
                            Id = TabId,
                            Caption = tabCaption ?? string.Empty,
                            Left = left,
                            Top = top,
                            Width = width,
                            Height = height
                        };
                    }
                    else
                    {
                        TabProfile = ServerService.GenerateDefaultTab(TabId);
                        TabProfile.Caption = tabCaption ?? string.Empty;
                        // TabProfile.Caption = GenerateDefaultTabCaption(TabIndex);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine("Failed to decode or parse query parameters: " + ex.Message);
            }
        }
    }

    protected override bool ShouldRender()
    {
        Console.WriteLine($"{DateTime.Now} Основное -  ShouldRender");

        return base.ShouldRender();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            js.InvokeVoidAsync("setDotNetHome", jsInteropService.ServiceObjectDotNetReference);
        }

        Console.WriteLine($"{DateTime.Now} Основное - OnAfterRender");

        base.OnAfterRender(firstRender);
    }

    protected override void OnParametersSet()
    {
        Console.WriteLine($"{DateTime.Now} Основное - ParametersSet!");

        base.OnParametersSet();
    }

    public int? ordersubscription { get; set; }

    public void Dispose()
    {
        try
        {
            if (UILogicSvcInstance != null)
            {
                UILogicSvcInstance.Dispose();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        GC.SuppressFinalize(this);
    }

    // private string GenerateDefaultTabCaption(int index)
    // {
    //     return Localizer["workspace"] + " " + index;
    // }

}
