    private void ProcessTicksFromQueue(object? sender, ElapsedEventArgs e)
    {
        if (TickQueue.IsEmpty) return;

        List<ClusterLevel> newTicks = new();
        while (TickQueue.TryDequeue(out ClusterLevel tick))
        {
            newTicks.Add(tick);
        }

        if (newTicks.Count > 0)
        {
            InvokeAsync(() =>
            {
                Ticks.AddRange(newTicks);
                if (Ticks.Count > 1000)
                {
                    Ticks.RemoveRange(0, Ticks.Count - 1000);
                }
                StateHasChanged();
                UpdateGridData();
            });
        }
    }

    private string GetClassForClusters(ClusterLevel _clusterLevel)
    {
        if (_clusterLevel.Volume == 0 || _clusterLevel.Volume == null)
        {
            return "transparent-item";
        }

        return _clusterLevel.BidVolume < _clusterLevel.AskVolume ? "highlighted-item" : "highlighted-item2";
    }

    public async void Dispose()
