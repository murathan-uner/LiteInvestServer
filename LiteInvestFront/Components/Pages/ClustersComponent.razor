@using LiteInvestFront.Entity
@using LiteInvestFront.Services
@using LiteInvest.Entity.Helpers
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using System.Collections.Concurrent
@using System.Timers

@inject UiLogicService _uilogicservice
@inject ServerService _serverService

@implements IDisposable
@inject IJSRuntime JSRuntime

<style>
    .clustersColumn {
    /* display: grid;
    grid-template-columns: 1fr 1fr 1fr; */
    }
</style>

@foreach(var i in Enumerable.Range(0, 3))
{
    <div class="split-pane clustersColumn">
        <TelerikGrid @ref="ClustersGrids[2-i]"
        Class="grid-cluster"
        EnableLoaderContainer="true"
        RowHeight="15"
        Height="100%"
        Data="@Ticks"
        TItem="@ClusterLevel"
        ScrollMode="@GridScrollMode.Virtual"
        PageSize="150">

            <GridColumns>
                <GridColumn Width="1fr" Field="@nameof(ClusterLevel.Volume)" HeaderClass="grid-header">
                    <FooterTemplate>
                        @if (times?.Count == 3)
                        {
                            @times[2-i];
                        }
                    </FooterTemplate>
                </GridColumn>
            </GridColumns>

            <RowTemplate Context="ClusterDatas">
                <td class="@GetClassForClusters(ClusterDatas)">
                    @if (ClusterDatas.Volume != 0)
                    {
                        @ClusterDatas.Volume.KiloFormat()
                    }
                </td>
            </RowTemplate>
        </TelerikGrid>
    </div>
}

