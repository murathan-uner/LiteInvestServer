@using LiteInvestFront.Entity
@using LiteInvestFront.Services
@using LiteInvest.Entity.Helpers
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity
@using LiteInvestServerDll
@using System.Collections.Concurrent

@inject UiLogicService UILogicSvcInstance
@inject ServerService _serverService

@implements IDisposable
@inject JsInteropService JSInteropService
@inject IJSRuntime JSRuntime

<div class="cluster-container algo-container table-container"></div>

@code {

    [Parameter] public string? TabId { get; set; }
    [Parameter] public SecurityApi? securityMain { get; set; }
    
    private int _scaleIndex = 0; // index  for ScaleList start on 0
    [Parameter]
    public int ScaleIndex
    {
        get => _scaleIndex;
        set
        {
            if (_scaleIndex != value)
            {
                _scaleIndex = value;

                if (!firstDataArrived || ScaleList.Count <= _scaleIndex)
                    return;

                PrepareUpdateData();

                var _dataSentFlag = dataSentFlag;

                needUpdateAll = true;
                UpdateTable(true);

                if (!_dataSentFlag)
                {
                    if (needUpdateFooter[0] || needUpdateFooter[1] || needUpdateFooter[2])
                        UpdateFooter();
                }
            }
        }
    }
    [Parameter] public List<int> ScaleList { get; set; } = new();

    private List<MarketDepthLevel> Ticks1 { get; set; } = new();
    private List<MarketDepthLevel> Ticks2 { get; set; } = new();
    private List<MarketDepthLevel> Ticks3 { get; set; } = new();
    private List<MarketDepthLevel> LastTicks { get; set; } = new();

    private ConcurrentDictionary<DateTime, List<MarketDepthLevel>> Cluster = new();
    private ConcurrentDictionary<int, ConcurrentDictionary<DateTime, List<MarketDepthLevel>>> ScaledCluster = new();

    private List<string> TimesFooter = new List<string>() { string.Empty, string.Empty, string.Empty };
    private string LastClusterTime { get; set; } = string.Empty;
    private string IdSubscription = string.Empty;

    private bool dataSentFlag = false;
    private bool disposed = false;

    protected override void OnInitialized()
    {
        InitializeFooter();
        base.OnInitialized();
    }

    protected override async void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // JSInteropService.OnInitializedQuote += OnInitializedQuoteCallback;
            JSInteropService.OnInitializedWindows += OnInitializedWindowsCallback;
            JSInteropService.OnAcceptedClusterData += OnAcceptedClusterDataCallback;
        }

        base.OnAfterRender(firstRender);
    }

    bool firstDataArrived = false;
    bool[] needUpdateFooter = new bool[3];
    bool needUpdatePrevious = false;
    bool needUpdateLast = false;
    bool needUpdateAll = false;

    private void PrepareUpdateData()
    {
        int myScale = ScaleList[ScaleIndex];
        Cluster = ScaledCluster[myScale];

        var timeCluster = Cluster.Keys.OrderByDescending(t => t).ToList();
        int timeCount = timeCluster.Count;

        for (int i = 0; i < Math.Min(3, timeCount); i++)
        {
            string footer = timeCluster[i].ToString("HH:mm");
            needUpdateFooter[i] = !TimesFooter[i].Equals(footer);
            TimesFooter[i] = footer;

            if (i == 0) {
                Ticks1 = Cluster[timeCluster[i]];
                if (LastTicks != Ticks1)
                {
                    needUpdateLast = true;
                    LastTicks = Ticks1;
                }
            }
            else if (i == 1) Ticks2 = Cluster[timeCluster[i]];
            else if (i == 2) Ticks3 = Cluster[timeCluster[i]];
        }

        needUpdatePrevious = !LastClusterTime.Equals(TimesFooter[0]);
        LastClusterTime = TimesFooter[0];
    }

    private void OnNewScaledCluster(InsideClusters insideClusters)
    {
        if (securityMain?.id != insideClusters.SecurityId)
            return;

        //Console.WriteLine($"{securityMain.Isin} CLusters UPDATE ");

        ScaledCluster = insideClusters.ScaledCluster;

        PrepareUpdateData();

        var _dataSentFlag = dataSentFlag;

        if (!firstDataArrived)
        {
            firstDataArrived = true;
            UpdateTable(true);
        }
        else
        {
            UpdateTable();
        }

        if (!_dataSentFlag)
        {
            if (needUpdateFooter[0] || needUpdateFooter[1] || needUpdateFooter[2])
                UpdateFooter();
        }

        // Console.WriteLine($"{securityMain.Isin} Max = {Ticks1[0].Price} ScaleIndex={Scale} ScaleValue={myScale} CLUSTERS UPDATE -> {DateTime.Now.ToString("mm:ss.fff")}  {times[0]} | {times[1]}| {times[2]} ");
    }

    private void UpdateTable(bool? firstTime = null)
    {
        if (dataSentFlag) return;
        dataSentFlag = true;
        needUpdateAll = false;

        if (needUpdateAll || (needUpdateLast && needUpdatePrevious)) {
            InvokeAsync(async () =>
            {
                if (disposed) return;
                var newData = new List<object> { Ticks1, Ticks2, Ticks3 };
                await JSRuntime.InvokeVoidAsync("updateClusterTableDataAll", securityMain?.SpecialHash, newData);
            });
        }
        else if (needUpdateLast)
        {
            InvokeAsync(async () =>
            {
                if (disposed) return;
                await JSRuntime.InvokeVoidAsync("updateClusterTableDataLast", securityMain?.SpecialHash, Ticks1);
            });
        }
        else if (needUpdatePrevious)
        {
            InvokeAsync(async () =>
            {
                if (disposed) return;
                var newData = new List<object> { Ticks2, Ticks3 };
                await JSRuntime.InvokeVoidAsync("updateClusterTableDataPrevious", securityMain?.SpecialHash, newData);
            });
        }
    }

    private void UpdateFooter()
    {
        InvokeAsync(async () =>
        {
            if (disposed) return;
            var newFooterTexts = new List<object> { TimesFooter[0], TimesFooter[1], TimesFooter[2] };
            await JSRuntime.InvokeVoidAsync("updateClusterFooterText", securityMain?.SpecialHash, newFooterTexts);
        });
    }

    private void InitializeFooter()
    {
        DateTime currentTime = DateTime.Now;

        // times.Add(currentTime.ToString("HH:mm"));
        // times.Add(currentTime.AddMinutes(-5).ToString("HH:mm"));
        // times.Add(currentTime.AddMinutes(-5).ToString("HH:mm"));

        TimesFooter.Add("");
        TimesFooter.Add("");
        TimesFooter.Add("");
    }

    public async void Dispose()
    {
        disposed = true;
        // JSInteropService.OnInitializedQuote -= OnInitializedQuoteCallback;
        JSInteropService.OnInitializedWindows -= OnInitializedWindowsCallback;
        JSInteropService.OnAcceptedClusterData -= OnAcceptedClusterDataCallback;

        if (securityMain != null && !string.IsNullOrEmpty(IdSubscription))
        {
            await _serverService.RemoveSubscribeForTicks(securityMain.id, IdSubscription);
        }
        // _uilogicservice.ScrollClusters -= ScrollClusters;
    }


    /* Begin Callbacks */

    private void OnInitializedWindowsCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        InvokeAsync(async () =>
        {
            if (securityMain != null && !disposed)
            {
                var res = await _serverService.SubscribeForAggregateCluster(securityMain.id, OnNewScaledCluster);
                if (res.Success)
                {
                    IdSubscription = res.Id;
                }
            }
        });
    }

    private void OnAcceptedClusterDataCallback(string windowId)
    {
        if (windowId != securityMain?.SpecialHash) return;

        dataSentFlag = false;
    }

    /* End Callbacks */
}
