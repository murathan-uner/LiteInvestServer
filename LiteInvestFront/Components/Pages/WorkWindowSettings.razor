@using LiteInvest.Entity.ServerEntity
@using LiteInvestFront.Services
@using LiteInvestFront.Shared
@using LiteInvestServerDll

@inject IJSRuntime JSRuntime
@inject UiLogicService UILogicSvcInstance
@inject ServerService _serverService

@if (securityMain != null)
{
    <TelerikWindow @bind-Visible=IsVisible
    Resizable="true"
    Draggable="true"
    MinWidth="400px"
    MinHeight="250px"
    CloseOnOverlayClick="false">
        <WindowTitle>
            <span>Настройки @securityMain.Isin</span>
        </WindowTitle>
        <WindowActions>
            <WindowAction Name="Close" />
        </WindowActions>
        <WindowContent>
            <div class="workWindowSettings__content">
                <section class="workWindowSettings__side-menu">
                    <span @onclick="() => {currentTab = Tabs.Trading;}" class="workWindowSettings__side-menu__item">Торговля</span>
                    <span @onclick="() => {currentTab = Tabs.DepthOfMarket;}" class="workWindowSettings__side-menu__item">Стакан</span>
                    <span @onclick="() => {currentTab = Tabs.Ticks;}" class="workWindowSettings__side-menu__item">Тики</span>
                    <span @onclick="() => {currentTab = Tabs.Clusters;}" class="workWindowSettings__side-menu__item">Кластеры</span>
                    <span @onclick="() => {currentTab = Tabs.Common;}" class="workWindowSettings__side-menu__item">Общие</span>
                </section>
                <section class="workWindowSettings__work-area">
                    @switch (currentTab)
                    {
                        case (Tabs.Trading):
                            for (var i = 0; i < LikeTradesVolume.Count; i++)
                            {
                                <VolumeInput Label="@($"Рабочий объем {i+1}:")" Value="@LikeTradesVolume[i]" ExtraData="@i" ValueChangedEvent="OnUpdatedOrderVolume" />
                            }
                            break;
                        case (Tabs.DepthOfMarket):
                            <span>DepthOfMarket</span>
                            break;
                        case (Tabs.Ticks):
                            <span>Ticks</span>
                            break;
                        case (Tabs.Clusters):
                            <span>Clusters</span>
                            break;
                        case (Tabs.Common):
                            <span>Common</span>
                            break;
                    }
                </section>
            </div>
        </WindowContent>
    </TelerikWindow>
}

@code {

    [Parameter] public string? TabId { get; set; }

    private SecurityApi? securityMain { get; set; }
    private List<int> LikeTradesVolume = [];

    private bool IsVisible = false;
    private Tabs currentTab = Tabs.Trading;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            UILogicSvcInstance.OrderVolumeUpdateAction += OnNotifiedOrderVolumeUpdate;
        }
    }

    public void Dispose()
    {
        UILogicSvcInstance.OrderVolumeUpdateAction -= OnNotifiedOrderVolumeUpdate;
    }

    public void UpdateVisibility(SecurityApi? sec)
    {
        if (sec == null)
        {
            IsVisible = false;
        }
        else if (securityMain != sec)
        {
            IsVisible = true;
        }
        else
        {
            IsVisible = !IsVisible;
        }

        if (IsVisible && sec != null)
        {
            securityMain = sec;
            var profile = _serverService.GetUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash);
            if (profile != null)
                LikeTradesVolume = profile.LikeTradesVolume;
            else
                IsVisible = false;
        }
        StateHasChanged();
    }

    public void OnUpdatedOrderVolume((int value, object? extraData) data)
    {
        if (securityMain == null || data.extraData == null)
            return;

        var newVolume = data.value;
        int index = (int)data.extraData;

        var profile = _serverService.GetUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash);
        if (profile != null)
        {
            profile.SetLikeTradeVolume(index, newVolume);
            _serverService.SaveUserInstrument(UILogicSvcInstance.userName, TabId, securityMain.SpecialHash, profile);
        }

        JSRuntime.InvokeVoidAsync("orderVolumeUpdate", securityMain.SpecialHash, index, newVolume);
    }

    private void OnNotifiedOrderVolumeUpdate(string windowId, int index, int newVolume)
    {
        if (windowId != securityMain?.SpecialHash)
            return;

        if (!IsVisible)
            return;

        if (LikeTradesVolume.Count <= index || index < 0)
            return;

        LikeTradesVolume[index] = newVolume;
        StateHasChanged();
    }

    enum Tabs
    {
        Trading = 0,
        DepthOfMarket = 1,
        Ticks = 2,
        Clusters = 3,
        Common = 4
    }
}