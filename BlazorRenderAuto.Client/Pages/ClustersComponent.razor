@	using BlazorRenderAuto.Client.Entity
@	using BlazorRenderAuto.Client.Services
@	using LiteInvest.Entity.Helpers
@	using LiteInvest.Entity.PlazaEntity
@	using LiteInvest.Entity.ServerEntity

@inject ApiDataService ApiDataService
@implements IDisposable
@inject IJSRuntime JSRuntime

<style>
    .clustersColumn {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
    }

</style>

<div class="clustersColumn">
    <TelerikGrid @ref="ClustersGrid3"
                 EnableLoaderContainer="true"
                 RowHeight="15"
                 Height="calc(100vh - 100px)"
                 Data="@ClusterDatas"
                
                 TItem="@ClusterLevel"
                 ScrollMode="@GridScrollMode.Virtual"
                 PageSize="@pagesize">

        <GridColumns>
            <GridColumn Width="1fr" Field="@nameof(ClusterLevel.Volume)" HeaderClass="grid-header">
                <FooterTemplate>
                    @if (times?.Count == 3)
                    {
                        @times[2];
                    }
                </FooterTemplate>
            </GridColumn>
        </GridColumns>

        <RowTemplate Context="ClusterDatas">
            <td class="@GetClassForClusters(ClusterDatas)">
                @if (ClusterDatas.Volume != 0)
                {
                    @ClusterDatas.Volume.KiloFormat()
                }
            </td>
        </RowTemplate>

    </TelerikGrid>

    <TelerikGrid @ref="ClustersGrid2"
                 EnableLoaderContainer="true"
                 RowHeight="15"
                 Height="calc(100vh - 100px)"
                 Data="@ClusterDatas"
                 TItem="@ClusterLevel"
                 ScrollMode="@GridScrollMode.Virtual"
                 PageSize="@pagesize">

        <GridColumns>
            <GridColumn Width="1fr" Field="@nameof(ClusterLevel.Volume)" HeaderClass="grid-header">
                <FooterTemplate>
                    @if (times?.Count == 3)
                    {
                        @times[1]
                        ;
                    }
                </FooterTemplate>
            </GridColumn>
        </GridColumns>

        <RowTemplate Context="ClusterDatas">
            <td class="@GetClassForClusters(ClusterDatas)">
                @if (ClusterDatas.Volume != 0)
                {
                    @ClusterDatas.Volume.KiloFormat()
                }
            </td>
        </RowTemplate>

    </TelerikGrid>

    <TelerikGrid @ref="ClustersGrid1"
                 EnableLoaderContainer="true"
                 RowHeight="15"
                 Height="calc(100vh - 100px)"
                 Data="@ClusterDatas"
                 TItem="@ClusterLevel"
                 ScrollMode="@GridScrollMode.Virtual"
                 PageSize="@pagesize">

        <GridColumns>
            <GridColumn Width="1fr" Field="@nameof(ClusterLevel.Volume)" HeaderClass="grid-header">
                <FooterTemplate>
                    @if (times?.Count == 3)
                    {
                        @times[0]
                        ;
                    }
                </FooterTemplate>
            </GridColumn>
        </GridColumns>

        <RowTemplate Context="ClusterDatas">
            <td class="@GetClassForClusters(ClusterDatas)">
                @if (ClusterDatas.Volume != 0)
                {
                    @ClusterDatas.Volume.KiloFormat()
                }
            </td>
        </RowTemplate>

    </TelerikGrid>

</div>

