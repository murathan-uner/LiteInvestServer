    private void OnNewMarketDepth(List<MarketDepthLevel> bids, List<MarketDepthLevel> asks, string secID)
    {
        
            if (secID != secutityMain.id)
                return;

            //с бинанса может такой апдейт прийти
            if (bids.Count != 0)
                usualbestbid = bids[0].Price;

            if (asks.Count != 0)
                usualbestAsk = asks[0].Price;

            lock (scalelocker)
            {
                savedAgregatedBestbid = usualbestbid - usualbestbid % (secutityMain.PriceStep * Scale);
                var easyDictionaryCurrent = BuildMarketDepthDictionary(bids, asks);

                newdictionaryQuotes = ScaleBuilderQuotes(easyDictionaryCurrent);
                AlgoQuotesScale(newdictionaryQuotes, usualbestbid, ApiDataService.crypto, savedAgregatedBestbid);
            }
    }

