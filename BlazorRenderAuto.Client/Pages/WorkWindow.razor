    }

    .tile-content {
    background-color: #fff;
    border-radius: 5px;
    }

    .k-grid-footer {
    padding-inline-end: 0px !important;
    }

    .dxbl-chart-root .dxbl-chart {
    padding: 0px !important;
    }


    .k-grid-content {
    scrollbar-width: none;
    }

    .k-grid-header {
    padding-inline-end: 0px !important;
    }
