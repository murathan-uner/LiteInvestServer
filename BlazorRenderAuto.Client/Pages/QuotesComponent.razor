    private string GetStyleForQuote(MarketDepthLevel quote)
    {
        // Максимальное значение, соответствующее 100%
        int maxVolume = 50000;

        int percentage = (int)((quote.Volume / (decimal)maxVolume) * 100);

        string gradient = "";

        if (quote.Volume == 0 || quote.Volume == null)
        {
            gradient = $"linear-gradient(to right, #c7a805 {percentage}%, #ffffff {percentage}%)";
        }
        else
        {
            if (percentage <= 100)
            {
                gradient = quote.Type == Side.Sell
                    ? $"linear-gradient(to right, #c7a805 {percentage}%, #edc6c6 {percentage}%)"
                    : $"linear-gradient(to right, #c7a805 {percentage}%, #a0dbc6 {percentage}%)";
            }
            else if (percentage <= 200)
            {
                int secondStripe = percentage - 100;

                gradient = $"linear-gradient(to right, #f8d0c0 {secondStripe}%, #c7a805 {secondStripe}%)";
            }
            else
            {
                int thirdStripe = percentage - 200;

                gradient = $"linear-gradient(to right, #c85dd9 {thirdStripe}%, #f8d0c0 {thirdStripe}%)";
            }
        }

        return $"background: {gradient};";
    }
    public string GetClassForQuote(MarketDepthLevel quote)
    {

        if (quote.Volume == 0 || quote.Volume == null)
        {
            return "transparent-item";
        }

        return quote.Type == Side.Sell ? "highlighted-item" : "highlighted-item2";

    }

