    private void AlgoQuotesScale(ConcurrentDictionary<decimal, MarketDepthLevel> newdictionaryQuotes, decimal bestbbid, bool crypto, bool scroll = true)
    {
        // if(!_firstrender)
        //    return;


        if (busy)
            return;

        busy = true;

        //поменялся масштаб
        if (Scale != prevbuildScale)
        {
            i++;
            prevbuildScale = Scale;

            //Применяем масштаб (даже если 1)
            //строим пустой стакан на всю длину
            var initialquotes = BuildInitialQuotes(bestbbid);
            QuotesDictionary.Clear();

            Quotes = CompareOldWithNewAndPlaceIndexes(newdictionaryQuotes, QuotesDictionary, initialquotes, crypto);
            ApiDataService.SendInitialQuotes(secutityMain, initialquotes, IndexesQuotes);

            UpdateBestBidIndex(bestbidagregated);

            UpdateQuotesGrid();

            //при изменении масштаба скролл не нужен, тем более у нас и так цена будет выше макс

            if (scroll)
                Helper.CreateTimerAndStart(() =>
                {

                    JSRuntime.InvokeVoidAsync("getScrollEvent2", GridTableId);

                    WorkWindow.ScrollTo(bestbidIndex, QuotesGrid);
                    UpdateQuotesGrid();

                    busy = false;
                    busyscroll = false;

                    middlescroll = true;

                }, 500, false);


            ApiDataService.ScrollClustes(secutityMain, bestbidIndex);

            if (scroll)
                return;
        }
        else
        {
            Quotes = CompareOldWithNewAndPlaceIndexes(newdictionaryQuotes, QuotesDictionary, Quotes, ApiDataService.crypto);
            UpdateQuotesGrid();
            UpdateBestBidIndex(bestbidagregated);
        }


        //TODO: проверить на фортс
        //--------------------

        if (middlescroll)
        {
            if (bestaskagregated > (decimal)maxpriceGRID && maxpriceGRID != 0)
            {

                Console.WriteLine($"{secutityMain.Isin} Scrolling to Middle MAX ");
                Helper.CreateTimerAndStart(() =>
                {

                    WorkWindow.ScrollTo(bestbidIndex, QuotesGrid);
                    UpdateQuotesGrid();
                    busy = false;

                }, 500, false);


                return;
            }



            if (bestbidagregated < (decimal)minpriceGrid && minchart != 0)
            {
                Console.WriteLine($"{secutityMain.Isin} Scrolling to MIN ");
                Helper.CreateTimerAndStart(() =>
                {

                    WorkWindow.ScrollTo(bestbidIndex, QuotesGrid);
                    UpdateQuotesGrid();
                    busy = false;

                }, 500, false);

                return;
            }
        }

        busy = false;

    }

