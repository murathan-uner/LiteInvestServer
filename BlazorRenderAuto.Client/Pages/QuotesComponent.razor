    private void UpdateMaxMinFromScroll(int skip)
    {

        if (skip == 0)
        {
            return;
        }

        if (Quotes!=null && Quotes.Count > skip)
        {

            if (maxpriceGRID==0)
                Console.WriteLine($"SCROLL | max price FOUND | = {Quotes[skip].Price}");

            if ((double)Quotes[skip].Price==maxpriceGRID)
                return;

            maxpriceGRID = (double)Quotes[skip].Price;

            var visiblerange = itemsinorderbook * (double)secutityMain.PriceStep * Scale;
            minpriceGrid = maxpriceGRID - visiblerange;

            if (visiblerange != 0)
            {
                Console.WriteLine($"SCROLL 1` max price = {Quotes[skip].Price} min = {minpriceGrid}");
                ApiDataService.SetNewMaxMin(secutityMain, maxpriceGRID,minpriceGrid);
            }

        }
    }

