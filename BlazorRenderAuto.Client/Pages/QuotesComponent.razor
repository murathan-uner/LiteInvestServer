    private void OnKeyDown(string windowId, string keyCode, bool isCtrl, bool isShift)
    {
        try
        {
            if (windowId != secutityMain.SpecialHash)
                return;



            if (keyCode == "KeyS")
            {
                middlescroll = false;
            }

            if (keyCode == "KeyM")
            {
                //двигаем в середину

                WorkWindow.ScrollTo(bestbidIndex, QuotesGrid);
                middlescroll = true;
                //GetPriceAfterScrollAndUpdateMaxMin();
            }

            if (keyCode == cancelHotKey)
            {
                /* foreach (var order in Orders)
                    {
                    ApiDataService.CancelOrder(order.Value);
                        } */
            }

            if (keyCode == plusHotKey)
            {
                if (Scale >= 5)
                {
                    var newScale = Scale - 5;

                    if (newScale == 0)
                        Scale = 1;
                    else Scale = newScale;

                    Console.WriteLine($"{secutityMain.Isin} New Agregation Step {Scale}");

                }
            }



            if (keyCode == minusHotKey)
            {
                if (Scale == 1)
                    Scale += 4;
                else Scale += 5;
                //UpdateAll();

                Console.WriteLine($"{secutityMain.Isin} New Agregation Step {Scale}");
            }

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        Console.WriteLine($"{keyCode} {windowId}");
    }


    private decimal GetRestVolumeFromOrders(decimal price)
    {
        if (Orders.ContainsKey(price))
            return Orders[price].VolumeExecuted;

        return 0;

    }


    private void NewMyOrder(Order myorder)
    {
        try
        {
            if (myorder.SecurityId != secutityMain.id)
                return;

            var restvolume = myorder.Volume - myorder.VolumeExecuted;
            Console.WriteLine($"New Order {myorder.SecurityId} side = {myorder.Side} price {myorder.PriceOrder} state {myorder.State} rv = {restvolume}");

            if (myorder.State == Order.OrderStateType.Activ || myorder.State == Order.OrderStateType.Partial)
            {

                Orders[myorder.PriceOrder] = myorder;

                if (IndexesQuotes.ContainsKey(myorder.PriceOrder) && Quotes.Count > IndexesQuotes[myorder.PriceOrder])
                {
                    Quotes[IndexesQuotes[myorder.PriceOrder]].RestVolume = myorder.Volume - myorder.VolumeExecuted;
                    UpdateQuotesGrid();
                }

            }

            else if (myorder.State == Order.OrderStateType.Done || myorder.State == Order.OrderStateType.Fail || myorder.State == Order.OrderStateType.Cancel)
            {

                Console.WriteLine($"Removing Order {myorder.SecurityId} price {myorder.PriceOrder} state {myorder.State}");
                Orders.Remove(myorder.PriceOrder, out var _);

                if (IndexesQuotes.ContainsKey(myorder.PriceOrder) && Quotes.Count > IndexesQuotes[myorder.PriceOrder])
                {
                    Quotes[IndexesQuotes[myorder.PriceOrder]].RestVolume = null;
                    UpdateQuotesGrid();
                }

            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }


