                @Quotes.Volume
            }
        </td>
        <td class="@GetClassForQuote(Quotes) price">
            @Quotes.Price.ToString("G29")
        </td>
        <td class="@GetClassForQuote(Quotes) restVolume">
            <span class="restVolumeSpan">
                @Quotes.RestVolume
            </span>
            @if (Quotes.RestVolume.ToString() != string.Empty)
            {
