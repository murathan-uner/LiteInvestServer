        </form>
        @*     <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button> *@

        <div id="dropdown-toggle" class="dropdown-toggle" @onclick="ToggleDropdown">
            <span>Торговля</span>
            <div class="dropdown-items" id="dropdown-items">
                <span @onclick="() => {orderswindowsVisible = !orderswindowsVisible;}">Активные ордера</span>
                <span @onclick="() => {poswindowVisible = !poswindowVisible;}">Активные позиции</span>
