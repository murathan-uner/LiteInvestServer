@code
{
    private async void LoginCLick(){
        if (textlogin == "Log In"){
            windowVisible = true;
        }
        else{
            MouseEventArgs args = new MouseEventArgs();
            await OnLoginClick(args);
        }
    }

    public class UserLoginData
