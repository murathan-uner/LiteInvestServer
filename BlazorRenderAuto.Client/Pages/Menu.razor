</div>



@code
{
    private bool poswindowVisible = false;
    private bool orderswindowsVisible = false;
    private async Task ToggleDropdown()
    {
        await js.InvokeVoidAsync("toggleDropdown");
    }


    private async void LoginCLick(){
        if (textlogin == "Log In"){
            windowVisible = true;
        }
        else{
            MouseEventArgs args = new MouseEventArgs();
            await OnLoginClick(args);
        }
    }

    public class UserLoginData
    {
        public string Login { get; set; }
        public string Password { get; set; }
    };

    //private UserLoginData loginInfo = new UserLoginData("samujan1@yandex.ru", "pass2");
    private UserLoginData loginInfo = new UserLoginData();

    private string lastOnChangeValue { get; set; }

    private async Task OnChangeHandler(object theUserInput)
    {
        string currValue = theUserInput as string;

        //if (currValue != lastOnChangeValue)
        {
           // lastOnChangeValue = currValue;

            if (Instruments.FirstOrDefault(i => i.Isin == AutoComplete) != null)
            {
                SecuritySelected = Instruments.FirstOrDefault(i => i.Isin == AutoComplete);
                AutoComplete = "";
            }
        }
    }

    bool windowVisible = false;

    [Parameter] public Action LoginClicked { get; set; }
    [Parameter] public Action<SecurityApi> NewSecSelected { get; set; }
    [Parameter] public ObservableCollection<SecurityApi> SecurityOpened { get; set; }

    IEnumerable<SecurityApi> Instruments { get; set; }
    string textlogin = "Log In";

    private string AutoComplete { get; set; }

    private SecurityApi _securityApiSelected;

    public SecurityApi SecuritySelected
    {
        get => _securityApiSelected;
        set
        {
            i++;
            _securityApiSelected = value;
            if (i != 1)
            {
                SecurityApiChanged(value);
            }
        }
    }
    public ElementReference LogInButton { get; set; }

    int i = 0;
    private bool loadingLogIn { get; set; }
    public string textForLogin { get; set; }
    public string colorforlogin { get; set; }

    public TelerikAutoComplete<SecurityApi> TelerikComboBox { get; set; }

    //Entity.LoginInfo? res;

    List<string> coins = new List<string>()
    {
        { "SOLUSDT" },
        { "AVAUSDT" },
        { "TRXUSDT" },
        { "ARCUSDT" }
    };


    List<string> FortsCoins = new List<string>()
    {
        { "Si-3.25" },
        { "AFLT-3.25" },
        { "LKOH-3.25" },
        { "VTBR-3.25" }
    };

    Dictionary<string, int> FortsCoins2 = new()
    {
        { "Si-3.25", 1 },
        { "AFLT-3.25",1 },
        { "LKOH-3.25",5},
        { "VTBR-3.25",1},
        {"SBRF-3.25",1}
    };

    private async Task<Task> OnLoginClick(MouseEventArgs obj)
    {

        try
        {
                loadingLogIn = true;
                colorforlogin = "black";
                textForLogin = "Входим";

                //var res = await ApiDataService.LogIn(loginInfo.Login, loginInfo.Password);
            var res = await ApiDataService.LogIn("samujan1@yandex.ru", "pass2");


                //TODO по хорошему на сервере надо убрать ответ NULL 
                if (res.errorMessage != "" && res.errorMessage!=null)
                {
                    textForLogin = res.errorMessage;
                    Console.WriteLine("ERROR LOGIN");

                    colorforlogin = "red";
                    loadingLogIn = false;
                    windowVisible = true;

                     return Task.CompletedTask;
                }
                //фатальная ошибка, то есть толи сервер мертв
                if (res == null || res.token=="")
                {
                    textForLogin = "Ошибка входа";
                    Console.WriteLine("ERROR LOGIN");

                    colorforlogin = "red";
                    loadingLogIn = false;
                    windowVisible = true;

                    return Task.CompletedTask;
                }

                colorforlogin = "green";
                textForLogin = "Успешно";

                textForLogin = "Грузим инструменты";
                Console.WriteLine("Loading instruments");
                Instruments = await ApiDataService.GetInstruments();
                SecuritySelected = Instruments.FirstOrDefault();

                textForLogin = $"Получено {Instruments.Count()}";
                Console.WriteLine($"Loaded instruments {Instruments.Count()}");

                textForLogin = "Готово";

                if (res.Name != null)
                    textlogin = res.Name;
                else
                {
                textlogin = "ON";
                }

                loadingLogIn = false;
                windowVisible = false;

                LoginClicked?.Invoke();

                if (ApiDataService.crypto)
                {
                    foreach (var coin in coins)
                    {
                        var sec = Instruments.FirstOrDefault(s => s.Isin == coin);
                        ApiDataService.OpenInstrument(sec);
                    }
                }
                else
                {
                    foreach (var coin in FortsCoins2)
                    {
                        var sec = Instruments.FirstOrDefault(s => s.Isin == coin.Key);
                        sec.Scale = coin.Value;

                        Task.Delay(200);
                        ApiDataService.OpenInstrument(sec);
                    }
                }

                return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            return Task.CompletedTask;
        }
    }

    private Task SecurityApiChanged(SecurityApi sec)
    {

        ApiDataService.OpenInstrument(sec);
        return Task.CompletedTask;
    }

    public void Dispose()
    {

        GC.SuppressFinalize(this);
    }
}
