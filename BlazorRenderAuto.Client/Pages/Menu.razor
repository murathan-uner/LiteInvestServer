@using System.Collections.ObjectModel
@using System.Reactive.Linq
@using BlazorRenderAuto.Client.Services
@using LiteInvest.Entity.ServerEntity
@using Telerik.Blazor.Components.RootComponent

@inject ApiDataService ApiDataService
@inject IJSRuntime js

@implements IDisposable

<TelerikWindow @bind-Visible=poswindowVisible
Resizable="true"
Draggable="true"
MinWidth="30%"
MinHeight="30%"
MaxHeight="90%"
MaxWidth="90%">
    <WindowContent>
        <Positions />
    </WindowContent>
    <WindowTitle>
        Активные позиции
    </WindowTitle>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>

</TelerikWindow>
<TelerikWindow @bind-Visible=orderswindowsVisible
Resizable="true"
Draggable="true"
MinWidth="30%"
MinHeight="30%"
MaxHeight="90%"
MaxWidth="90%">
    <WindowContent>
        <Orders />
    </WindowContent>
    <WindowTitle>
        Активные ордера
    </WindowTitle>
    <WindowActions>
        <WindowAction Name="Close" />
    </WindowActions>
</TelerikWindow>

<TelerikWindow @bind-Visible=windowVisible
Resizable="true"
MinWidth="300"
MinHeight="200"
Centered="true"
Modal="true"
MaxWidth="800"
CloseOnOverlayClick="true"
MaxHeight="500">
    <WindowContent>

        <TelerikForm Model="@loginInfo">
            <FormItems>
                <FormItem Field="@nameof(UserLoginData.Login)">

                </FormItem>
                <FormItem Field="@nameof(UserLoginData.Password)">

                </FormItem>
            </FormItems>

            <FormButtons>
                <TelerikButton OnClick="OnLoginClick" Class="login_button">
                    Войти
                    <TelerikLoader Class="loader-indicator" ThemeColor="light" Visible="@loadingLogIn"></TelerikLoader>
                </TelerikButton>

            </FormButtons>
        </TelerikForm>
        @if (!string.IsNullOrWhiteSpace(@textForLogin))
        {
            <p style="color: @colorforlogin;">@textForLogin</p>
        }
    </WindowContent>
</TelerikWindow>

<div class="top-menu">
    <section class="top-menu__section">
        <a class="brand" href="/">LiteInvest</a>
        @*         <form class="d-flex internalSearch" role="search">
                <DxComboBox Data="@Instruments"
                            ValueFieldName="Isin"
                            @bind-Value="@SecuritySelected"
                            TextFieldName="@nameof(SecuritySelected.Isin)"
