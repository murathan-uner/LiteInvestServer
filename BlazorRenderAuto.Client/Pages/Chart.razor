@using BlazorRenderAuto.Client.Entity
@using BlazorRenderAuto.Client.Services
@using LiteInvest.Entity.PlazaEntity
@using LiteInvest.Entity.ServerEntity

@inject ApiDataService ApidataService
@implements IDisposable

<TelerikChart Height="calc(100vh - 100px)" @ref="Chart2" Class="chart" Transitions="false" RenderAs="@RenderingMode.Canvas" Width="100%">

    <ChartLegend Visible="false"></ChartLegend>
    <ChartPannable Enabled="false"></ChartPannable>

    <ChartSeriesItems>

        <ChartSeries Type="ChartSeriesType.ScatterLine"
        Data="@Ticks"
        YField="@nameof(TradeApi.Price)"
        XField="@nameof(TradeApi.IndexForChart)"
        Color="#808080"
        ZIndex="0"
        >

            <ChartSeriesMarkers Visible="false">
            </ChartSeriesMarkers>


        </ChartSeries>


        <ChartSeries Type="ChartSeriesType.Bubble"
        Data="@Ticks"
        YField="@nameof(TradeApi.Price)"
        XField="@nameof(TradeApi.IndexForChart)"
        SizeField="@nameof(TradeApi.Volume)"
        ColorField="@nameof(TradeApi.Color)"
        Opacity ="0.6"
        ZIndex="1"
        >

            <ChartSeriesLabels Visible="true"
            Template="chartSeriesLabelTemplate"
            AriaTemplate="chartSeriesAriaTemplate" />

        </ChartSeries>

    </ChartSeriesItems>


    <ChartXAxes>
        <ChartXAxis Max="@counter" Min="@(counter-maxamount)" Visible="false">
        </ChartXAxis>
    </ChartXAxes>

    <ChartYAxes>
        <ChartYAxis Min="@minchart" Max="@maxchart" Visible="false">
        </ChartYAxis>
    </ChartYAxes> 

</TelerikChart>


<script suppress-error="BL9992">
    function chartSeriesLabelTemplate(context) {
    return context.dataItem.Volume;
    }

</script>

@code {

    public List<TradeApi> Ticks { get; set; }

    public int maxamount { get; set; } = 30; //надо разделить на шаг и получится реальное количество отображаемых элементов

    static int maxStaticValue { get; set; } = 30;
    public int maxScaleForChart { get; set; } = 200;

    [Parameter]
    public SecurityApi secutityMain { get; set; }

    double minchart { get; set; } 
    double maxchart { get; set; } 

    public TelerikChart Chart2 { get; set; }

    int counter = 1;

    int lastvalue = 0;


    protected override async Task OnInitializedAsync()
    {

        if (Ticks == null)
        {
            Ticks = new List<TradeApi>();
            // Ticks.Add(new TradeApi(){IndexForChart = 0, Size = 100,});

            //TODO: нам помоему сервер не отдает это значение
            basicvolume = secutityMain.Lot * maxScaleForChart;
            Ticks.Add(new TradeApi() { IndexForChart = -3 * maxStaticValue, Volume = basicvolume, });

            //Console.WriteLine($"{secutityMain.Isin} max value for chart {secutityMain.Lot * 300}");

            ChangeScaleOfChart();
        }

        base.OnInitializedAsync();
    }

    private void ProcessNewMaxMin(SecurityApi sec, double max, double min)
    {
        if(sec.SpecialHash!=secutityMain.SpecialHash)
            return;

        SetMaxMin(max, min);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {

            ApidataService.NewTicks += ProcessTicks;
            ApidataService.NewMaxMin += ProcessNewMaxMin;

        }

        base.OnAfterRender(firstRender);
    }

    public void ChangeScaleOfChart()
    {
        //TODO: решил сделать реализацию через инжект.
        // Возможно это опасно

        var newvalue = ApidataService.openedInstruments;

        if (newvalue == 0) newvalue = 1;

        if(lastvalue==newvalue)
            return;

        lastvalue = newvalue;

        var res = maxStaticValue / (newvalue );


        if (Ticks!=null && Ticks.Count > 0)
        {
            Ticks[0].Volume = basicvolume / newvalue;
        }

        maxamount = (int)res;

        if(Ticks!=null && Ticks.Count>0)
            Console.WriteLine($"new max amount {maxamount} {secutityMain.Isin}  №{newvalue} of windows (CHART MESSAGE) ticksvol = {Ticks[0].Volume}");
        InvokeAsync(StateHasChanged);
    }

    decimal basicvolume = 0;


    int chartcount = 0;

    DateTime lasttickupdate;

    public void ProcessTicks(string sec, List<TradeApi> ticks)
    {

        if (sec != secutityMain.id)
            return;

        if(ticks==null)
            return;

        if (ApidataService.crypto)
        {
          //  if (!(ticks[0].Time > lasttickupdate + TimeSpan.FromMilliseconds(200)))
            //    return;
        }

        try
        {
            foreach (var tick in ticks)
            {

                counter += 1;
                tick.IndexForChart = counter;

                //Console.WriteLine($" {secutityMain.Isin} Added New tick {tick.Price} index {tick.IndexForChart}");
                Ticks.Add(tick);

                if (Ticks.Count > maxamount)
                    Ticks.RemoveAt(1);
            }

            if (Ticks.Count > 1)
                Ticks[0].Price = Ticks[1].Price;

        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        
        InvokeAsync(StateHasChanged);
    }

    double range = 0;

    public async void PushInvokeAsync()
    {
        InvokeAsync(StateHasChanged);
    }

    protected override bool ShouldRender()
    {
        //Console.WriteLine($"CHART Should Render {secutityMain.Isin}  {DateTime.Now}");

        return base.ShouldRender();
    }


    public void SetMaxMin(double max, double min)
    {
        try
        {
            minchart = min;
            maxchart = max;

            InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private void UpdateChart()
    {
        InvokeAsync(() =>
        {
            try
            {
                Chart2.Refresh();
            }
            catch (Exception ex)
            {
                Console.WriteLine(ex.Message);
            }
        }).GetAwaiter().GetResult();
    }

    public void Dispose()
    {
       
        ApidataService.NewMaxMin -= ProcessNewMaxMin;
        ApidataService.NewTicks -= ProcessTicks;
    }

}
